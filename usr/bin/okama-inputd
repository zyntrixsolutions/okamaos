#!/usr/bin/env python3
"""okama-inputd — OkamaOS system input daemon.

Reads raw evdev events from USB and Bluetooth HID gamepads plus system
keyboards, normalises them, and broadcasts Okama unified input events as
newline-delimited JSON to a Unix domain socket.

Architecture:
  - One thread per /dev/input/eventN device
  - Main thread accepts socket connections and fans out events to all clients
  - Hot-plug handled by polling /dev/input for generic evdev devices
  - Keyboard support is enabled for shell navigation, games, and terminal flows

Usage (daemon mode — called by init script):
  okama-inputd --daemon

Usage (interactive test):
  okama-inputd --test
"""

import sys
import os

_lib = os.environ.get("OKAMA_LIB", "")
if not _lib:
    _lib = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../lib")
sys.path.insert(0, os.path.abspath(_lib))

import argparse
import json
import socket
import threading
import time
import struct
import glob
import select
import logging

from okamaos.input_protocol import SOCKET_PATH, BUTTONS, AXES
import okamaos.config as cfg_mod

LOG_PATH = "/var/okamaos/logs/okama-inputd.log"

logging.basicConfig(
    level=logging.WARNING,
    format="%(asctime)s [okama-inputd] %(levelname)s %(message)s",
    handlers=[logging.StreamHandler(sys.stderr)],
)
log = logging.getLogger("okama-inputd")

# evdev event struct: (time_sec, time_usec, type, code, value)  — 24 bytes
EVFMT = "llHHi"
EVSIZE = struct.calcsize(EVFMT)

EV_SYN  = 0
EV_KEY  = 1
EV_ABS  = 3
EV_MSC  = 4

EVIOCGBIT_BASE = 0x80000000 | (ord("E") << 8)

# evdev ABS axis indices
ABS_X    = 0
ABS_Y    = 1
ABS_RX   = 3
ABS_RY   = 4
ABS_HAT0X = 16
ABS_HAT0Y = 17
ABS_Z    = 2   # L2 trigger
ABS_RZ   = 5   # R2 trigger

BTN_A      = 0x130  # BTN_SOUTH
BTN_B      = 0x131  # BTN_EAST
BTN_X      = 0x133  # BTN_WEST (note: raw codes vary by driver)
BTN_Y      = 0x134  # BTN_NORTH
BTN_TL     = 0x136
BTN_TR     = 0x137
BTN_TL2    = 0x138
BTN_TR2    = 0x139
BTN_SELECT = 0x13a
BTN_START  = 0x13b
BTN_MODE   = 0x13c  # HOME / Guide

BUTTON_MAP = {
    0x120: "A",
    0x121: "B",
    0x122: "X",
    0x123: "Y",
    0x124: "L1",
    0x125: "R1",
    0x126: "L2",
    0x127: "R2",
    0x128: "SELECT",
    0x129: "START",
    0x130: "A",
    0x131: "B",
    0x133: "X",
    0x134: "Y",
    0x136: "L1",
    0x137: "R1",
    0x138: "L2",
    0x139: "R2",
    0x13a: "SELECT",
    0x13b: "START",
    0x13c: "HOME",
    0x13d: "L3",
    0x13e: "R3",
    0x220: "DPAD_UP",
    0x221: "DPAD_DOWN",
    0x222: "DPAD_LEFT",
    0x223: "DPAD_RIGHT",
}

AXIS_MAP = {
    ABS_X:    ("LSTICK_X", False, False),
    ABS_Y:    ("LSTICK_Y", True, False),
    ABS_RX:   ("RSTICK_X", False, False),
    ABS_RY:   ("RSTICK_Y", True, False),
    ABS_Z:    ("L2_AXIS",  False, True),
    ABS_RZ:   ("R2_AXIS",  False, True),
}

HAT_MAP = {
    ABS_HAT0X: ("DPAD_LEFT", "DPAD_RIGHT"),
    ABS_HAT0Y: ("DPAD_UP",   "DPAD_DOWN"),
}


KEYBOARD_BUTTON_MAP = {
    1: "B",           # ESC
    14: "B",          # Backspace
    15: "SELECT",     # Tab
    28: "A",          # Enter
    57: "A",          # Space
    103: "DPAD_UP",
    105: "DPAD_LEFT",
    106: "DPAD_RIGHT",
    108: "DPAD_DOWN",
    17: "DPAD_UP",    # W
    30: "DPAD_LEFT",  # A
    31: "DPAD_DOWN",  # S
    32: "DPAD_RIGHT", # D
    35: "HOME",       # H
}


def normalise_axis(raw: int, inverted: bool = False,
                   trigger: bool = False,
                   abs_range: tuple[int, int] | None = None) -> float:
    """Map common evdev axis ranges to the Okama normalized range."""
    if abs_range:
        min_v, max_v = abs_range
        span = max_v - min_v
        if span > 0:
            if trigger:
                v = (raw - min_v) / span
                return round(max(0.0, min(1.0, v)), 3)
            center = min_v + span / 2.0
            half = span / 2.0
            v = (raw - center) / half
            if inverted:
                v = -v
            if abs(v) < 0.08:
                v = 0.0
            return round(max(-1.0, min(1.0, v)), 3)

    if trigger:
        if raw <= 255:
            v = raw / 255.0
        elif raw <= 1023:
            v = raw / 1023.0
        elif raw <= 65535:
            v = raw / 65535.0
        else:
            v = raw / 32767.0
        v = max(0.0, min(1.0, v))
        return round(v, 3)

    if raw < 0:
        v = raw / 32768.0
    elif raw <= 255:
        v = (raw - 127.5) / 127.5
    elif raw <= 1023:
        v = (raw - 511.5) / 511.5
    elif raw <= 32767:
        v = raw / 32767.0
    elif raw <= 65535:
        v = (raw - 32767.5) / 32767.5
    else:
        v = raw / 32767.0
    if inverted:
        v = -v
    if abs(v) < 0.08:
        v = 0.0
    return round(max(-1.0, min(1.0, v)), 3)


class ControllerThread(threading.Thread):
    def __init__(self, path: str, controller_id: int,
                 broadcast_fn, disconnect_fn):
        super().__init__(daemon=True)
        self.path = path
        self.controller_id = controller_id
        self.broadcast = broadcast_fn
        self.disconnect_fn = disconnect_fn
        self._stop = threading.Event()
        self._hat_state: dict = {}
        self._axis_ranges: dict[int, tuple[int, int]] = {}

    def run(self):
        try:
            fd = open(self.path, "rb")
        except (PermissionError, FileNotFoundError) as e:
            log.warning("Cannot open %s: %s", self.path, e)
            return

        name = self._read_name(fd)
        self._axis_ranges = self._read_axis_ranges(fd)
        log.info("Controller %d connected: %s (%s)",
                 self.controller_id, name, self.path)
        self.broadcast({
            "type": "connect",
            "controller": self.controller_id,
            "name": name,
            "bus": "usb",
            "path": self.path,
        })

        try:
            while not self._stop.is_set():
                r, _, _ = select.select([fd], [], [], 0.1)
                if not r:
                    continue
                data = fd.read(EVSIZE)
                if len(data) < EVSIZE:
                    break
                _, _, ev_type, code, value = struct.unpack(EVFMT, data)
                self._handle(ev_type, code, value)
        except OSError:
            pass
        finally:
            fd.close()
            log.info("Controller %d disconnected.", self.controller_id)
            self.broadcast({
                "type": "disconnect",
                "controller": self.controller_id,
            })
            self.disconnect_fn(self.controller_id)

    def _handle(self, ev_type: int, code: int, value: int):
        if ev_type == EV_KEY:
            btn = BUTTON_MAP.get(code)
            if btn:
                self.broadcast({
                    "type": "button",
                    "button": btn,
                    "state": "pressed" if value else "released",
                    "controller": self.controller_id,
                })
        elif ev_type == EV_ABS:
            if code in AXIS_MAP:
                axis_name, inverted, trigger = AXIS_MAP[code]
                self.broadcast({
                    "type": "axis",
                    "axis": axis_name,
                    "value": normalise_axis(
                        value, inverted, trigger,
                        self._axis_ranges.get(code)),
                    "controller": self.controller_id,
                })
            elif code in HAT_MAP:
                neg_btn, pos_btn = HAT_MAP[code]
                prev = self._hat_state.get(code)
                current = None
                if value < 0:
                    current = neg_btn
                elif value > 0:
                    current = pos_btn

                if prev and prev != current:
                    self.broadcast({"type": "button", "button": prev,
                                    "state": "released", "controller": self.controller_id})
                if current and current != prev:
                    self.broadcast({"type": "button", "button": current,
                                    "state": "pressed", "controller": self.controller_id})
                elif current is None and prev is None:
                    for btn in (neg_btn, pos_btn):
                        self.broadcast({"type": "button", "button": btn,
                                        "state": "released", "controller": self.controller_id})
                self._hat_state[code] = current

    def _read_name(self, fd) -> str:
        import fcntl
        EVIOCGNAME = 0x80ff4506
        buf = bytearray(256)
        try:
            fcntl.ioctl(fd, EVIOCGNAME, buf)
            return buf.decode(errors="replace").rstrip("\x00").strip()
        except Exception:
            return os.path.basename(self.path)

    def _read_axis_ranges(self, fd) -> dict[int, tuple[int, int]]:
        import fcntl
        ranges = {}
        for code in AXIS_MAP:
            request = EVIOCGBIT_BASE | (24 << 16) | (0x40 + code)
            buf = bytearray(24)
            try:
                fcntl.ioctl(fd, request, buf)
                _, min_v, max_v, _, _, _ = struct.unpack("iiiiii", buf)
            except OSError:
                continue
            if max_v > min_v:
                ranges[code] = (min_v, max_v)
        return ranges

    def stop(self):
        self._stop.set()


class KeyboardThread(threading.Thread):
    """Keyboard-to-Okama input path for shell navigation and games."""

    def __init__(self, path: str, broadcast_fn, disconnect_fn):
        super().__init__(daemon=True)
        self.path = path
        self.broadcast = broadcast_fn
        self.disconnect_fn = disconnect_fn
        self._stop = threading.Event()

    def run(self):
        try:
            fd = open(self.path, "rb")
        except (PermissionError, FileNotFoundError) as e:
            log.warning("Cannot open keyboard %s: %s", self.path, e)
            return

        name = self._read_name(fd)
        log.info("Keyboard connected: %s (%s)", name, self.path)
        self.broadcast({
            "type": "connect",
            "controller": -1,
            "name": name,
            "bus": "keyboard",
            "path": self.path,
        })

        try:
            while not self._stop.is_set():
                r, _, _ = select.select([fd], [], [], 0.1)
                if not r:
                    continue
                data = fd.read(EVSIZE)
                if len(data) < EVSIZE:
                    break
                _, _, ev_type, code, value = struct.unpack(EVFMT, data)
                if ev_type != EV_KEY or value not in (0, 1):
                    continue
                button = KEYBOARD_BUTTON_MAP.get(code)
                if button:
                    self.broadcast({
                        "type": "button",
                        "button": button,
                        "state": "pressed" if value else "released",
                        "controller": -1,
                    })
        except OSError:
            pass
        finally:
            fd.close()
            self.broadcast({
                "type": "disconnect",
                "controller": -1,
                "path": self.path,
            })
            self.disconnect_fn(self.path)

    def _read_name(self, fd) -> str:
        import fcntl
        EVIOCGNAME = 0x80ff4506
        buf = bytearray(256)
        try:
            fcntl.ioctl(fd, EVIOCGNAME, buf)
            return buf.decode(errors="replace").rstrip("\x00").strip()
        except Exception:
            return os.path.basename(self.path)

    def stop(self):
        self._stop.set()


class InputDaemon:
    def __init__(self, dev_mode: bool = False):
        self.dev_mode = dev_mode
        self._clients: list = []
        self._clients_lock = threading.Lock()
        self._controllers: dict = {}   # id -> ControllerThread
        self._keyboards: dict = {}     # path -> KeyboardThread
        self._next_id = 0
        self._id_lock = threading.Lock()
        self._stop = threading.Event()
        conf = cfg_mod.get()
        self.keyboard_enabled = conf.get(
            "SYSTEM_KEYBOARD_ENABLED",
            conf.get("KEYBOARD_FALLBACK", "yes"),
        ).lower() == "yes"

    def broadcast(self, event: dict) -> None:
        line = (json.dumps(event) + "\n").encode()
        with self._clients_lock:
            dead = []
            for conn in self._clients:
                try:
                    conn.sendall(line)
                except OSError:
                    dead.append(conn)
            for c in dead:
                self._clients.remove(c)

    def _on_disconnect(self, controller_id: int) -> None:
        with self._id_lock:
            self._controllers.pop(controller_id, None)

    def _on_keyboard_disconnect(self, path: str) -> None:
        self._keyboards.pop(path, None)

    def _next_controller_id(self) -> int:
        with self._id_lock:
            cid = self._next_id
            self._next_id += 1
        return cid

    def _scan_devices(self):
        """Enumerate /dev/input/event* and start readers for new input devices."""
        existing_paths = {t.path for t in self._controllers.values()}
        existing_paths.update(self._keyboards)
        for path in sorted(glob.glob("/dev/input/event*")):
            if path in existing_paths:
                continue
            if self._is_gamepad(path):
                cid = self._next_controller_id()
                t = ControllerThread(
                    path, cid, self.broadcast, self._on_disconnect)
                self._controllers[cid] = t
                t.start()
            elif self.keyboard_enabled and self._is_keyboard(path):
                t = KeyboardThread(path, self.broadcast,
                                   self._on_keyboard_disconnect)
                self._keyboards[path] = t
                t.start()

    def _is_gamepad(self, path: str) -> bool:
        """Return True if the device looks like a joystick/gamepad."""
        bits = self._ev_bits(path, EV_SYN, 32)
        if not self._bit_is_set(bits, EV_KEY):
            return False
        key_bits = self._ev_bits(path, EV_KEY, 96)
        has_gamepad_button = any(
            self._bit_is_set(key_bits, code)
            for code in tuple(BUTTON_MAP) + tuple(range(0x120, 0x140))
        )
        has_abs = self._bit_is_set(bits, EV_ABS)
        name = self._device_name(path).lower()
        return has_gamepad_button or (has_abs and any(
            token in name for token in ("gamepad", "joystick", "controller", "xbox", "sony")
        ))

    def _is_keyboard(self, path: str) -> bool:
        """Return True if the device exposes keyboard keys."""
        name = self._device_name(path).lower()
        if "keyboard" in name or "kbd" in name:
            return True
        bits = self._ev_bits(path, EV_KEY, 96)
        required = (17, 30, 31, 32, 28)  # W/A/S/D/Enter
        arrows = (103, 105, 106, 108)
        return all(self._bit_is_set(bits, code) for code in required) and any(
            self._bit_is_set(bits, code) for code in arrows
        )

    def _device_name(self, path: str) -> str:
        event = os.path.basename(path)
        name_path = f"/sys/class/input/{event}/device/name"
        try:
            with open(name_path) as f:
                return f.read().strip()
        except OSError:
            return event

    def _ev_bits(self, path: str, ev_type: int, size: int) -> bytes:
        import fcntl
        request = EVIOCGBIT_BASE | (size << 16) | (0x20 + ev_type)
        buf = bytearray(size)
        try:
            with open(path, "rb") as fd:
                fcntl.ioctl(fd, request, buf)
            return bytes(buf)
        except OSError:
            return b""

    def _bit_is_set(self, bits: bytes, bit: int) -> bool:
        idx = bit // 8
        if idx >= len(bits):
            return False
        return bool(bits[idx] & (1 << (bit % 8)))

    def run_server(self):
        if os.path.exists(SOCKET_PATH):
            os.remove(SOCKET_PATH)
        os.makedirs(os.path.dirname(SOCKET_PATH), exist_ok=True)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCKET_PATH)
        srv.listen(8)
        srv.setblocking(False)
        log.info("okama-inputd listening on %s", SOCKET_PATH)

        last_scan = 0.0
        while not self._stop.is_set():
            now = time.time()
            if now - last_scan > 2.0:
                self._scan_devices()
                last_scan = now

            r, _, _ = select.select([srv], [], [], 0.5)
            if r:
                try:
                    conn, _ = srv.accept()
                    with self._clients_lock:
                        self._clients.append(conn)
                    log.debug("Client connected (%d total)",
                              len(self._clients))
                except OSError:
                    pass

        srv.close()
        try:
            os.remove(SOCKET_PATH)
        except FileNotFoundError:
            pass

    def test_mode(self):
        """Interactive test — print events to stdout."""
        print("okama-inputd test mode. Press controller buttons. Ctrl-C to exit.")
        self._scan_devices()
        original_broadcast = self.broadcast

        def print_broadcast(event: dict):
            print(json.dumps(event))
            original_broadcast(event)

        self.broadcast = print_broadcast

        try:
            while True:
                self._scan_devices()
                time.sleep(2)
        except KeyboardInterrupt:
            print("\nDone.")


def main():
    p = argparse.ArgumentParser(prog="okama-inputd")
    p.add_argument("--daemon", action="store_true",
                   help="Run as socket server daemon (called by init)")
    p.add_argument("--test", action="store_true",
                   help="Print events to stdout (controller test mode)")
    p.add_argument("--debug", action="store_true")
    args = p.parse_args()

    if args.debug:
        logging.getLogger().setLevel(logging.DEBUG)

    conf = cfg_mod.get()
    dev = conf.is_dev_mode()

    daemon = InputDaemon(dev_mode=dev)

    if args.test:
        daemon.test_mode()
    else:
        daemon.run_server()


if __name__ == "__main__":
    main()
