#!/bin/sh
# S20okama-devices — device node setup via eudev (udevd).
# Falls back to mdev (BusyBox) if eudev is absent.

case "$1" in
  start)
    # Preload graphics/input drivers when available so installed boots and
    # hotplugged controllers enumerate before okama-shell and okama-inputd start.
    modprobe bochs-drm 2>/dev/null || true
    modprobe drm_kms_helper 2>/dev/null || true
    modprobe drm 2>/dev/null || true
    modprobe usbhid 2>/dev/null || true
    modprobe hid-generic 2>/dev/null || true
    modprobe joydev 2>/dev/null || true
    modprobe evdev 2>/dev/null || true
    modprobe xpad 2>/dev/null || true
    modprobe hid-microsoft 2>/dev/null || true
    modprobe hid-sony 2>/dev/null || true
    modprobe hid-playstation 2>/dev/null || true
    
    if which udevd >/dev/null 2>&1; then
        echo "Starting eudev..."
        udevd --daemon
        udevadm trigger --action=add
        udevadm settle --timeout=5
    elif which mdev >/dev/null 2>&1; then
        echo "Starting mdev (fallback)..."
        echo /sbin/mdev > /proc/sys/kernel/hotplug
        mdev -s
    else
        echo "WARNING: no device manager found. USB hotplug will not work."
    fi
    ;;
  stop)
    killall udevd 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
