#!/bin/sh
# S40okama-network — bring up networking only if enabled.
# For MVP this handles wired (DHCP). WiFi wpa_supplicant hook is a stub.

CONF=/etc/okamaos/okama.conf
NET_ENABLED=yes
WIFI_ENABLED=no
WPA_CONF=/etc/wpa_supplicant.conf

if [ -f "$CONF" ]; then
    NET_ENABLED=$(grep '^NETWORK_ENABLED=' "$CONF" | cut -d= -f2 | tr -d '[:space:]')
    WIFI_ENABLED=$(grep '^WIFI_ENABLED='   "$CONF" | cut -d= -f2 | tr -d '[:space:]')
fi

start_dhcp() {
    iface="$1"
    if command -v udhcpc >/dev/null 2>&1; then
        udhcpc -b -i "$iface" 2>/dev/null && return 0
    fi
    dhcpcd -b "$iface" 2>/dev/null || true
}

settle_devices() {
    if command -v udevadm >/dev/null 2>&1; then
        udevadm settle --timeout=5 2>/dev/null || true
    else
        sleep 1
    fi
}

bring_up() {
    iface="$1"
    ifconfig "$iface" up 2>/dev/null || ip link set "$iface" up 2>/dev/null || true
}

unblock_wifi() {
    if command -v rfkill >/dev/null 2>&1; then
        rfkill unblock wifi 2>/dev/null || true
        rfkill unblock wlan 2>/dev/null || true
    fi
}

case "$1" in
  start)
    if [ "$NET_ENABLED" = "yes" ]; then
        echo "Starting network services..."
        settle_devices
        bring_up lo
        for iface_path in /sys/class/net/*; do
            iface="$(basename "$iface_path")"
            [ "$iface" = "lo" ] && continue
            [ -d "$iface_path/wireless" ] && continue
            [ "$(cat "$iface_path/type" 2>/dev/null)" = "1" ] || continue
            echo "Starting DHCP on $iface..."
            bring_up "$iface"
            start_dhcp "$iface"
        done

        if [ "$WIFI_ENABLED" = "yes" ]; then
            unblock_wifi
            for iface_path in /sys/class/net/*; do
                iface="$(basename "$iface_path")"
                [ -d "$iface_path/wireless" ] || continue
                echo "Preparing WiFi interface $iface..."
                bring_up "$iface"
                if [ -s "$WPA_CONF" ]; then
                    echo "Starting wpa_supplicant and DHCP on $iface..."
                    wpa_supplicant -B -i "$iface" -c "$WPA_CONF" 2>/dev/null || true
                    start_dhcp "$iface"
                else
                    echo "No $WPA_CONF yet; WiFi interface is up for UI scanning."
                fi
            done
        fi
    else
        echo "Network disabled — skipping."
    fi
    ;;
  stop)
    dhcpcd --exit 2>/dev/null || true
    killall udhcpc 2>/dev/null || true
    killall wpa_supplicant 2>/dev/null || true
    ;;
  restart|reload)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload}"
    exit 1
    ;;
esac
