#!/bin/sh
# S99okama-shell — pre-flight setup before the shell launcher runs on tty1.
# The shell itself is started by inittab tty1::respawn (not this script).
# This script only does early setup that must happen during sysinit.

case "$1" in
  start)
    exec >> /var/okamaos/logs/boot.log 2>&1
    echo "[S99] pre-flight: checking framebuffer..."
    if [ -e /dev/fb0 ]; then
        echo "[S99] /dev/fb0 found"
    else
        echo "[S99] WARNING: /dev/fb0 not present yet (udev may not have settled)"
    fi
    echo "[S99] pre-flight done — shell will start via inittab tty1::respawn"
    echo "[S99] pre-flight done" > /dev/ttyS0 2>/dev/null || true
    ;;
  stop)
    killall okama-shell 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
