#!/usr/bin/env python3
"""okama-safe-ui - Pygame-free framebuffer UI for OkamaOS v2.0.4."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import select
import struct
import subprocess
import sys
import termios
import time
import tty


COL_BG = (7, 8, 18)
COL_GRID = (16, 28, 52)
COL_TEXT = (238, 240, 255)
COL_DIM = (128, 132, 154)
COL_CYAN = (0, 238, 238)
COL_MAGENTA = (255, 0, 128)
COL_GREEN = (0, 245, 120)
COL_WARN = (255, 156, 36)
COL_CARD = (24, 26, 48)

SECTIONS = ["Play", "Settings", "Power"]
POWER_OPTIONS = ["Restart", "Shut Down", "Cancel"]

