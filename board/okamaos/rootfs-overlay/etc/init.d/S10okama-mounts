#!/bin/sh
# S10okama-mounts — mount required filesystems.
# Runs early in boot before any OkamaOS service.

case "$1" in
  start)
    echo "Mounting OkamaOS filesystems..."

    mount -t proc  none /proc  2>/dev/null || true
    mount -t sysfs none /sys   2>/dev/null || true
    mount -t devtmpfs none /dev 2>/dev/null || true
    mkdir -p /dev/pts
    mount -t devpts none /dev/pts 2>/dev/null || true

    # tmpfs for run-time state — mount first, then create dirs ON the tmpfs.
    # /var/lock and /var/run are symlinks to /run/lock and /run in the
    # Buildroot FHS skeleton; dirs must be created AFTER the mount or they
    # are wiped when the fresh tmpfs overlays /run.
    mkdir -p /run
    mount -t tmpfs -o size=32m tmpfs /run 2>/dev/null || true
    mkdir -p /run/lock /run/lock/subsys /run/dbus /run/network

    # Live USB persistence: if a partition labelled OKAMA_DATA exists, mount it
    # over /var/okamaos before services create games/saves/update state.
    mkdir -p /var/okamaos
    PERSIST_LABEL="${OKAMA_PERSISTENCE_LABEL:-OKAMA_DATA}"
    PERSIST_DEV=""
    if [ -e "/dev/disk/by-label/${PERSIST_LABEL}" ]; then
        PERSIST_DEV="$(readlink -f "/dev/disk/by-label/${PERSIST_LABEL}" 2>/dev/null || true)"
    fi
    if [ -z "$PERSIST_DEV" ] && command -v blkid >/dev/null 2>&1; then
        PERSIST_DEV="$(blkid -L "$PERSIST_LABEL" 2>/dev/null || true)"
    fi
    if [ -n "$PERSIST_DEV" ] && ! grep -q ' /var/okamaos ' /proc/mounts; then
        mount -o rw,noatime "$PERSIST_DEV" /var/okamaos 2>/dev/null || true
    fi

    # /var/okamaos is persistent when a data partition is present; otherwise it
    # remains in the live rootfs. Ensure all runtime dirs exist either way.
    mkdir -p /var/okamaos/games \
             /var/okamaos/saves \
             /var/okamaos/logs  \
             /var/okamaos/cache \
             /var/okamaos/controllers \
             /var/okamaos/updates \
             /var/okamaos/updates/backups \
             /var/okamaos/updates/downloads \
             /var/okamaos/updates/history \
             /var/okamaos/updates/game-backups

    # Mount available removable/media volumes after persistence is established
    # so package/update discovery can scan a stable /media tree.
    mkdir -p /media /var/okamaos/downloads
    if [ -x /usr/bin/okama-mount-media ]; then
        /usr/bin/okama-mount-media > /var/okamaos/logs/media-mount.log 2>&1 || true
    fi
    ;;
  stop)
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
