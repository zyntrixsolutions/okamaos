{
  "name": "Platformer Template",
  "id": "com.okamalabs.template.platformer",
  "version": "0.1.0",
  "runtime": "okama-sdl2",
  "entry": "main.py",
  "min_ram_mb": 64,
  "target_fps": 30,
  "permissions": ["controller", "audio", "save_data"],
  "age_rating": "Everyone",
  "supports_save_state": true,
  "controller_required": true,
  "keyboard_usage": "none"
}
