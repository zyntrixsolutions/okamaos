#!/bin/sh
# S90okama-password — set root password from configuration or default.
# This runs late in init so the root filesystem is writable.
#
# The password can be set via:
#   - /etc/okamaos/password.conf  (ROOT_PASSWORD=...)
#   - Fallback to 'zyntrix' if no config exists

CONF=/etc/okamaos/password.conf
ROOT_PW=zyntrix

if [ -f "$CONF" ]; then
    PW=$(grep '^ROOT_PASSWORD=' "$CONF" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')
    if [ -n "$PW" ]; then
        ROOT_PW="$PW"
    fi
fi

echo "root:$ROOT_PW" | chpasswd 2>/dev/null || {
    # Fallback: busybox passwd if chpasswd unavailable
    echo "$ROOT_PW" | passwd root 2>/dev/null
}

exit 0
