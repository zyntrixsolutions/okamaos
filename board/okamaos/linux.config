# OkamaOS minimal kernel config fragment for x86_64.
#
# This is a fragment / starter; merge it on top of x86_64_defconfig in the
# kernel tree. Buildroot will use it directly via
# BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG.
#
# Console-grade goals: small, fast boot, gamepad-first, no desktop.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_PREEMPT=y

# Boot
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_LOG_BUF_SHIFT=16

# VT / TTY (required for framebuffer console and tty1 shell)
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_UNIX98_PTYS=y

# Initramfs support (required for ISO/cpio.gz boot)
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# PCI bus (required for VIRTIO_PCI and SATA)
CONFIG_PCI=y
CONFIG_PCI_DIRECT=y

# Block / virtio (for QEMU)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# SATA/SCSI for VirtualBox disk
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Display
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_I915=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Firmware/GRUB framebuffer (gfxpayload=keep passes screen_info to kernel)
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB_SIMPLE=y
# VESA framebuffer fallback for BIOS VMs (VirtualBox VBoxVGA / vesafb)
CONFIG_FB_VESA=y
CONFIG_VGASTATE=y
# EFI framebuffer for UEFI boot path
CONFIG_FB_EFI=y

# Audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_USB_AUDIO=y

# Serial UART (ttyS0 — needed for console=ttyS0,115200 debug output)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Serial I/O bus (PS/2 keyboard and mouse — VirtualBox provides i8042)
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y

# Input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y

# PS/2 keyboard and mouse (VirtualBox BIOS and EFI mode)
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_SYNAPTICS=y

# USB HID mouse and keyboard
CONFIG_USB_MOUSE=y
CONFIG_USB_KBD=y

# HID / controllers
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_SONY=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_MICROSOFT=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y

# Bluetooth
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y

# USB
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y

# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# ACPI (required for clean shutdown/reboot on VirtualBox and real hardware)
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y

# EFI stub for UEFI boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Power
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y

# Security baseline
CONFIG_SECURITY=y

# NOTE: kernel-version-dependent options:
#   - CONFIG_HID_PLAYSTATION: requires Linux >= 5.16
#   - CONFIG_HID_NINTENDO: requires Linux >= 5.16 (Switch Pro Controller)
#   - CONFIG_DRM_VIRTIO_GPU: requires Linux >= 5.0
# Adjust if your chosen kernel version is older than 5.16.
