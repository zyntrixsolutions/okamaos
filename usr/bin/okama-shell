# ---------------------------------------------------------------------------
# Network Monitor Module
# ---------------------------------------------------------------------------
class NetworkMonitor:
    """Monitor network connectivity status."""
    
    def __init__(self):
        self.is_online = False
        self.connection_type = "none"  # "ethernet", "wifi", "none"
        self.ssid = None
        self.last_check = 0
        self.check_interval = 5.0
        self._lock = threading.Lock()
        self._thread = threading.Thread(target=self._monitor_loop, daemon=True)
        self._running = True
        self._thread.start()
    
    def _monitor_loop(self):
        """Background thread for network monitoring."""
        while self._running:
            self._check_connection()
            time.sleep(self.check_interval)
    
    def _check_connection(self):
        """Check actual internet connectivity."""
        online = False
        conn_type = "none"
        ssid = None
        
        try:
            # Check if we have any network interface with an IP
            result = subprocess.run(
                ["ip", "route", "show"], 
                capture_output=True, text=True, timeout=2
            )
            has_route = "default" in result.stdout
            
            # Determine connection type
            if has_route:
                # Check for WiFi
                wifi_result = subprocess.run(
                    ["iwgetid", "-r"], 
                    capture_output=True, text=True, timeout=1
                )
                if wifi_result.returncode == 0 and wifi_result.stdout.strip():
                    conn_type = "wifi"
                    ssid = wifi_result.stdout.strip()
                else:
                    # Check for ethernet interfaces
                    for iface in ["eth0", "enp0s3", "enp1s0", "ens33"]:
                        ethtool_result = subprocess.run(
                            ["cat", f"/sys/class/net/{iface}/operstate"],
                            capture_output=True, text=True, timeout=1
                        )
                        if ethtool_result.returncode == 0 and "up" in ethtool_result.stdout:
                            conn_type = "ethernet"
                            break
                
                # Test actual internet connectivity
                try:
                    sock = sock_module.socket(sock_module.AF_INET, sock_module.SOCK_STREAM)
                    sock.settimeout(3)
                    result = sock.connect_ex(("8.8.8.8", 53))
                    online = (result == 0)
                    sock.close()
                except Exception:
                    pass
        except Exception:
            pass
        
        with self._lock:
            self.is_online = online
            self.connection_type = conn_type
            self.ssid = ssid
            self.last_check = time.time()
    
    def get_status(self):
        """Get current network status."""
        with self._lock:
            return {
                "online": self.is_online,
                "type": self.connection_type,
                "ssid": self.ssid,
            }
    
    def stop(self):
        self._running = False


# ---------------------------------------------------------------------------
# Cyberpunk Grid Background Renderer
# ---------------------------------------------------------------------------
class CyberGridBackground:
    """Animated checkered net/fence cyberpunk background."""
    
    def __init__(self, width, height):
        self.width = width
        self.height = height
        self.grid_size = 40
        self.perspective_y = height * 0.6
        self.horizon_y = height * 0.3
        self.offset = 0.0
        self.scanline_offset = 0
        self.pulse = 0.0
        
    def update(self, dt):
        """Update animation state."""
        self.offset = (self.offset + dt * 30) % self.grid_size
        self.scanline_offset = (self.scanline_offset + 1) % 4
        self.pulse = (self.pulse + dt * 2) % (2 * math.pi)
    
    def draw(self, screen):
        """Draw the cyberpunk grid background."""
        # Base background
        screen.fill(COL_BG)
        
        # Draw perspective grid (floor)
        self._draw_perspective_grid(screen)
        
        # Draw ceiling grid
        self._draw_ceiling_grid(screen)
        
        # Draw side fences
        self._draw_side_fences(screen)
        
        # Draw animated scanlines
        self._draw_scanlines(screen)
        
        # Draw vignette
        self._draw_vignette(screen)
        
        # Draw pulsing accent lines
        self._draw_accent_lines(screen)
    
    def _draw_perspective_grid(self, screen):
        """Draw perspective floor grid (vanishing point effect)."""
        vanishing_x = self.width // 2
        vanishing_y = self.horizon_y
        
        # Vertical perspective lines
        for i in range(-20, 21):
            x_base = vanishing_x + i * 60
            # Line from vanishing point to bottom
            pygame.draw.line(
                screen, 
                (COL_BG_GRID[0] + 20, COL_BG_GRID[1] + 20, COL_BG_GRID[2] + 30),
                (vanishing_x, vanishing_y),
                (x_base + (i * 30), self.height),
                1
            )
        
        # Horizontal moving lines (perspective effect)
        for i in range(15):
            y = self.perspective_y + (self.height - self.perspective_y) * (i / 15) ** 1.5
            y = (y + self.offset * ((i + 1) / 15)) % self.height
            if y > self.perspective_y:
                alpha = int(60 * (1 - (y - self.perspective_y) / (self.height - self.perspective_y)))
                color = (COL_ACCENT[0] * alpha // 255, COL_ACCENT[1] * alpha // 255, COL_ACCENT[2] * alpha // 255)
                pygame.draw.line(screen, color, (0, int(y)), (self.width, int(y)), 1)
    
    def _draw_ceiling_grid(self, screen):
        """Draw ceiling grid above horizon."""
        vanishing_x = self.width // 2
        vanishing_y = self.horizon_y
        
        # Vertical ceiling lines
        for i in range(-15, 16):
            x_offset = i * 80
            pygame.draw.line(
                screen,
                (COL_BG_GRID[0] + 10, COL_BG_GRID[1] + 10, COL_BG_GRID[2] + 20),
                (vanishing_x, vanishing_y),
                (vanishing_x + x_offset, 0),
                1
            )
        
        # Horizontal ceiling lines
        for i in range(8):
            y = (vanishing_y * (i / 8) ** 2) - self.offset * 0.3
            y = max(0, y % vanishing_y)
            alpha = int(40 * (1 - y / vanishing_y))
            color = (COL_ACCENT2[0] * alpha // 255, COL_ACCENT2[1] * alpha // 255, COL_ACCENT2[2] * alpha // 255)
            pygame.draw.line(screen, color, (0, int(y)), (self.width, int(y)), 1)
    
    def _draw_side_fences(self, screen):
        """Draw side fence/net patterns."""
        fence_width = 120
        
        # Left fence
        for i in range(10):
            x = i * (fence_width // 10)
            alpha = int(80 * (1 - x / fence_width))
            color = (COL_ACCENT[0] * alpha // 255, COL_ACCENT[1] * alpha // 255, COL_ACCENT[2] * alpha // 255)
            # Diagonal lines
            offset = (self.offset + i * 10) % 60
            pygame.draw.line(screen, color, 
                (x, self.horizon_y + offset), 
                (x + 30, self.height), 1)
            pygame.draw.line(screen, color,
                (x, self.horizon_y - offset),
                (x + 30, 0), 1)
        
        # Right fence
        for i in range(10):
            x = self.width - i * (fence_width // 10)
            alpha = int(80 * (1 - (self.width - x) / fence_width))
            color = (COL_ACCENT2[0] * alpha // 255, COL_ACCENT2[1] * alpha // 255, COL_ACCENT2[2] * alpha // 255)
            offset = (self.offset + i * 10) % 60
            pygame.draw.line(screen, color,
                (x, self.horizon_y + offset),
                (x - 30, self.height), 1)
            pygame.draw.line(screen, color,
                (x, self.horizon_y - offset),
                (x - 30, 0), 1)
    
    def _draw_scanlines(self, screen):
        """Draw retro CRT scanline effect."""
        scanline_color = (0, 0, 0, 30)
        for y in range(self.scanline_offset, self.height, 4):
            overlay = pygame.Surface((self.width, 1), pygame.SRCALPHA)
            overlay.fill(scanline_color)
            screen.blit(overlay, (0, y))
    
    def _draw_vignette(self, screen):
        """Draw vignette effect for depth."""
        for i in range(100):
            alpha = int(30 * (i / 100) ** 2)
            color = (0, 0, 0, alpha)
            # Top vignette
            overlay = pygame.Surface((self.width, 2), pygame.SRCALPHA)
            overlay.fill(color)
            screen.blit(overlay, (0, i * 2))
            # Bottom vignette
            screen.blit(overlay, (0, self.height - i * 2 - 2))
    
    def _draw_accent_lines(self, screen):
        """Draw pulsing accent lines."""
        pulse_intensity = int(128 + 127 * math.sin(self.pulse))
        
        # Top accent line
        pygame.draw.line(screen, 
            (COL_ACCENT[0], COL_ACCENT[1], pulse_intensity), 
            (0, self.horizon_y), (self.width, self.horizon_y), 2)
        
        # Bottom glow line
        glow_y = self.height - 4
        for i in range(3):
            alpha = int(100 * (1 - i/3) * (0.5 + 0.5 * math.sin(self.pulse * 2)))
            color = (COL_ACCENT2[0], COL_ACCENT2[1], COL_ACCENT2[2], alpha)
            overlay = pygame.Surface((self.width, 2), pygame.SRCALPHA)
            overlay.fill(color)
            screen.blit(overlay, (0, glow_y + i * 2))


# ---------------------------------------------------------------------------
# Fallback text renderer (no Pygame)
# ---------------------------------------------------------------------------
def _text_shell():
    """Minimal text-mode shell for terminals / no-Pygame environments."""
    conf = cfg_mod.get()
    print("\n" + "=" * 48)
    print(f"  OkamaOS v{conf.get('VERSION', okamaos.VERSION)} Shell  (text mode)")
    print("=" * 48)

    while True:
        games = games_mod.list_installed()
        print("\nInstalled games:")
        for i, g in enumerate(games):
            print(f"  [{i+1}] {g['name']} ({g['id']})")
        print("  [p] Power off")
        print("  [r] Reboot")
        print("  [q] Exit shell (dev mode only)")

        try:
            choice = input("\nSelect > ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            break

        if choice == "q":
            if conf.is_dev_mode():
                break
            print("Not in developer mode.")
        elif choice == "p":
            subprocess.call(["poweroff"])
        elif choice == "r":
            subprocess.call(["reboot"])
        elif choice.isdigit():
            idx = int(choice) - 1
            if 0 <= idx < len(games):
                gid = games[idx]["id"]
                os.execv("/usr/bin/okama-run", ["okama-run", gid])
            else:
                print("Invalid selection.")


def _log_shell_error(message: str):
    try:
        os.makedirs("/var/okamaos/logs", exist_ok=True)
        with open("/var/okamaos/logs/shell.log", "a", encoding="utf-8") as log:
            log.write(message + "\n")
    except Exception:
        pass


def _has_alsa_output() -> bool:
    cards_path = "/proc/asound/cards"
    try:
        with open(cards_path, encoding="utf-8", errors="replace") as cards:
            data = cards.read().strip().lower()
        return bool(data) and "no soundcards" not in data
    except FileNotFoundError:
        return bool(glob.glob("/dev/snd/controlC*") or glob.glob("/dev/snd/pcm*"))
    except Exception:
        return False


def _select_shell_audio_driver(conf) -> str:
    configured = (conf.get("AUDIO_BACKEND", "alsa") or "alsa").strip().lower()
    if configured == "alsa" and not _has_alsa_output():
        return "dummy"
    return configured or "dummy"


def _configure_sdl_environment(conf, windowed: bool) -> None:
    os.environ.setdefault("SDL_VIDEODRIVER", "kmsdrm")
    os.environ.setdefault("SDL_KMSDRM_REQUIRE_DRM_MASTER", "0")
    os.environ.setdefault("SDL_FBDEV",
                          conf.get("FRAMEBUFFER_DEVICE", "/dev/fb0"))
    os.environ.setdefault("SDL_AUDIODRIVER",
                          _select_shell_audio_driver(conf))
    os.environ.setdefault("SDL_RENDER_DRIVER", "software")
    os.environ.setdefault("LIBGL_ALWAYS_SOFTWARE", "1")
    os.environ.setdefault("MESA_LOADER_DRIVER_OVERRIDE", "kms_swrast")

    if windowed:
        os.environ["SDL_VIDEODRIVER"] = "x11"  # dev host


class ShellFont:
    """Small bitmap renderer that avoids pygame font/native freetype modules."""

    def __init__(self, size: int, bold: bool = False):
        self.scale = max(2, int(round(size / 7)))
        self.bold = bold

    def render(self, text: str, antialias_or_color, color=None):
        if color is None:
            color = antialias_or_color
        text = str(text)
        width = max(1, len(text) * 6 * self.scale + (1 if self.bold else 0))
        height = 7 * self.scale
        surf = pygame.Surface((width, height), pygame.SRCALPHA)
        for idx, char in enumerate(text.upper()):
            glyph = BITMAP_FONT.get(char, BITMAP_FONT["?"])
            base_x = idx * 6 * self.scale
            for row_idx, row in enumerate(glyph):
                for col_idx, bit in enumerate(row):
                    if bit == "1":
                        rect = (
                            base_x + col_idx * self.scale,
                            row_idx * self.scale,
                            self.scale,
                            self.scale,
                        )
                        pygame.draw.rect(surf, color, rect)
                        if self.bold:
                            bold_rect = (
                                rect[0] + max(1, self.scale // 4),
                                rect[1],
                                rect[2],
                                rect[3],
                            )
                            pygame.draw.rect(surf, color, bold_rect)
        return surf


# ---------------------------------------------------------------------------
# Pygame shell
# ---------------------------------------------------------------------------
class OkamaShell:
    def __init__(self, windowed: bool = False, dev_mode: bool = False):
        self.windowed = windowed
        self.dev_mode = dev_mode
        self.conf = cfg_mod.get()
        self.version = self.conf.get("VERSION", okamaos.VERSION)

        flags = 0 if windowed else pygame.FULLSCREEN | pygame.NOFRAME
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT), flags)
        pygame.display.set_caption(f"OkamaOS v{self.version}")
        pygame.mouse.set_visible(False)

        self.clock = pygame.time.Clock()
        self._init_fonts()

        # Cyberpunk animated background
        self.bg = CyberGridBackground(WIDTH, HEIGHT)

        # Network monitor
        self.net_monitor = NetworkMonitor()

        # Input handling
        self.input_client = InputClient()
        self.input_client.connect()
        self.keyboard_enabled = True

        # UI State
        self.state = "home"
        self.section_idx = 0
        self.list_idx = 0
        self.settings_idx = 0
        self.power_idx = 0
        self.message = ""
        self.message_timer = 0
        self.update_notices = []
        self.update_check_done = False
        self.update_check_error = ""
        self.show_online_status = True

        # Game list
        self.games = []
        self._refresh_games()

        # Input timing
        self._input_cooldown = 0
        self._axis_threshold = 0.5
        self._axis_held: dict = {}
        self._last_frame_time = time.time()

        # Start update check
        self._start_update_check()

    def _init_fonts(self):
        try:
            test_font = ShellFont(24)
            if test_font.render("OkamaOS", COL_TEXT).get_width() <= 0:
                raise RuntimeError("bitmap font rendered empty text")
        except Exception as e:
            raise RuntimeError(f"Bitmap text renderer unavailable: {e}")

        self.font_xl = ShellFont(72, bold=True)
        self.font_lg = ShellFont(42, bold=True)
        self.font_md = ShellFont(28)
        self.font_sm = ShellFont(20)
        self.font_hint = ShellFont(18)

    def _draw_logo(self, center_x: int, y: int, scale: float = 1.0):
        width = int(520 * scale)
        mark_w = int(112 * scale)
        mark_h = int(82 * scale)
        x = center_x - width // 2

        pygame.draw.rect(self.screen, COL_TEXT, (x, y, mark_w, mark_h),
                         border_radius=max(3, int(5 * scale)))
        inset = max(6, int(9 * scale))
        pygame.draw.rect(self.screen, COL_BG,
                         (x + inset, y + inset, mark_w - inset * 2,
                          mark_h - inset * 3), border_radius=2)
        pygame.draw.circle(self.screen, COL_OK,
                           (x + int(34 * scale), y + int(34 * scale)),
                           max(5, int(9 * scale)))
        pygame.draw.rect(self.screen, COL_WARN,
                         (x + int(56 * scale), y + int(27 * scale),
                          int(35 * scale), max(4, int(5 * scale))))
        pygame.draw.rect(self.screen, COL_ACCENT2,
                         (x + int(56 * scale), y + int(43 * scale),
                          int(26 * scale), max(4, int(5 * scale))))
        pygame.draw.rect(self.screen, COL_TEXT,
                         (x + int(18 * scale), y + int(91 * scale),
                          int(76 * scale), int(15 * scale)))

        logo = self.font_xl.render("OkamaOS", True, COL_TEXT)
        word_x = x + mark_w + int(28 * scale)
        self.screen.blit(logo, (word_x, y + int(3 * scale)))
        wave = self.font_sm.render("FIRST WAVE", True, COL_OK)
        self.screen.blit(wave, (word_x + int(6 * scale),
                                y + int(72 * scale)))

    def _refresh_games(self):
        self.games = games_mod.list_installed()

    def _show_message(self, msg: str, duration: float = 2.5):
        self.message = msg
        self.message_timer = int(duration * FPS)

    def _start_update_check(self):
        if self.conf.get("UPDATE_CHECK_ENABLED", "yes").lower() != "yes":
            self.update_check_done = True
            return

        def worker():
            notices, error = updates_mod.check_all(installed=self.games)
            self.update_notices = notices
            self.update_check_error = error or ""
            self.update_check_done = True

        threading.Thread(target=worker, daemon=True).start()

    def run(self):
        running = True
        while running:
            now = time.time()
            dt = now - self._last_frame_time
            self._last_frame_time = now

            self.clock.tick(FPS)

            # Update animated background
            self.bg.update(dt)

            events = self._collect_events()

            for e in events:
                if e.get("type") == "QUIT":
                    running = False

            self._handle_input(events)

            self._draw()

            if self.message_timer > 0:
                self.message_timer -= 1

        self.net_monitor.stop()
        pygame.quit()

    # -----------------------------------------------------------------------
    # Input collection (controller socket + full keyboard support)
    # -----------------------------------------------------------------------
    def _collect_events(self) -> list:
        events = []

        # Controller events from okama-inputd
        for ev in self.input_client.poll():
            if ev.get("controller") == -1:
                continue
            if ev.get("type") == "button" and ev.get("state") == "pressed":
                events.append({"src": "controller", "action": ev["button"]})
            elif ev.get("type") == "axis":
                self._handle_axis_to_dpad(ev, events)

        # Full keyboard support (primary input alongside controllers)
        for pev in pygame.event.get():
            if pev.type == pygame.QUIT:
                events.append({"type": "QUIT"})
            elif pev.type == pygame.KEYDOWN:
                k = pev.key
                mapping = {
                    # Navigation
                    pygame.K_UP:     "DPAD_UP",
                    pygame.K_DOWN:   "DPAD_DOWN",
                    pygame.K_LEFT:   "DPAD_LEFT",
                    pygame.K_RIGHT:  "DPAD_RIGHT",
                    pygame.K_w:      "DPAD_UP",
                    pygame.K_s:      "DPAD_DOWN",
                    pygame.K_a:      "DPAD_LEFT",
                    pygame.K_d:      "DPAD_RIGHT",
                    # Actions
                    pygame.K_RETURN: "A",
                    pygame.K_SPACE:  "A",
                    pygame.K_ESCAPE: "B",
                    pygame.K_BACKSPACE: "B",
                    # Special
                    pygame.K_TAB:    "TAB",
                    pygame.K_HOME:   "START",
                    pygame.K_1:      "SECTION_1",
                    pygame.K_2:      "SECTION_2",
                    pygame.K_3:      "SECTION_3",
                    pygame.K_q:      "QUIT" if self.dev_mode else None,
                }
                action = mapping.get(k)
                if action == "QUIT":
                    events.append({"type": "QUIT"})
                elif action:
                    events.append({"src": "keyboard", "action": action})

        return events

    def _handle_axis_to_dpad(self, ev: dict, out: list):
        axis = ev.get("axis", "")
        value = ev.get("value", 0.0)
        prev = self._axis_held.get(axis, 0.0)

        if axis in ("LSTICK_Y", "RSTICK_Y"):
            if value < -self._axis_threshold and prev >= -self._axis_threshold:
                out.append({"src": "axis", "action": "DPAD_UP"})
            elif value > self._axis_threshold and prev <= self._axis_threshold:
                out.append({"src": "axis", "action": "DPAD_DOWN"})
        elif axis in ("LSTICK_X", "RSTICK_X"):
            if value < -self._axis_threshold and prev >= -self._axis_threshold:
                out.append({"src": "axis", "action": "DPAD_LEFT"})
            elif value > self._axis_threshold and prev <= self._axis_threshold:
                out.append({"src": "axis", "action": "DPAD_RIGHT"})

        self._axis_held[axis] = value

    # -----------------------------------------------------------------------
    # State machine
    # -----------------------------------------------------------------------
    def _handle_input(self, events: list):
        if self._input_cooldown > 0:
            self._input_cooldown -= 1
            return

        for ev in events:
            action = ev.get("action")
            if not action:
                continue
            self._input_cooldown = 6  # ~100ms at 60 fps
            self._dispatch(action)

    def _dispatch(self, action: str):
        # Global shortcuts
        if action == "L1" or action == "TAB":
            self.section_idx = (self.section_idx - 1) % len(SECTIONS)
            if self.state != "home":
                self.state = "home"
            return
        elif action == "R1":
            self.section_idx = (self.section_idx + 1) % len(SECTIONS)
            if self.state != "home":
                self.state = "home"
            return
        elif action == "START":
            if self.state != "home":
                self.state = "home"
            return
        elif action.startswith("SECTION_"):
            try:
                idx = int(action.split("_")[1]) - 1
                if 0 <= idx < len(SECTIONS):
                    self.section_idx = idx
                    if self.state != "home":
                        self.state = "home"
            except (ValueError, IndexError):
                pass
            return

        if self.state == "home":
            self._home_input(action)
        elif self.state == "play":
            self._play_input(action)
        elif self.state == "settings":
            self._settings_input(action)
        elif self.state == "power":
            self._power_input(action)

    def _home_input(self, action: str):
        n = len(SECTIONS)
        if action == "DPAD_RIGHT":
            self.section_idx = (self.section_idx + 1) % n
        elif action == "DPAD_LEFT":
            self.section_idx = (self.section_idx - 1) % n
        elif action == "A":
            section = SECTIONS[self.section_idx]
            if section == "Play":
                self._refresh_games()
                self.list_idx = 0
                self.state = "play"
            elif section == "Settings":
                self.settings_idx = 0
                self.state = "settings"
            elif section == "Power":
                self.power_idx = 0
                self.state = "power"

    def _play_input(self, action: str):
        n = len(self.games)
        if action == "B" or action == "START":
            self.state = "home"
        elif action == "DPAD_DOWN":
            if n:
                self.list_idx = (self.list_idx + 1) % n
        elif action == "DPAD_UP":
            if n:
                self.list_idx = (self.list_idx - 1) % n
        elif action == "A":
            if self.games:
                self._launch_game(self.games[self.list_idx])

    def _launch_game(self, game: dict):
        gid = game["id"]
        self._show_message(f"Launching {game['name']}…")
        self._draw()
        pygame.display.flip()
        time.sleep(0.5)
        pygame.quit()
        os.execv("/usr/bin/okama-run", ["okama-run", gid])

    def _settings_input(self, action: str):
        n = len(SETTINGS_OPTIONS)
        if action == "B" or action == "START":
            self.state = "home"
        elif action == "DPAD_DOWN":
            self.settings_idx = (self.settings_idx + 1) % n
        elif action == "DPAD_UP":
            self.settings_idx = (self.settings_idx - 1) % n
        elif action == "A":
            opt = SETTINGS_OPTIONS[self.settings_idx]
            if opt == "Controllers":
                self._show_message(
                    "Controller: connected (USB HID). "
                    "Bluetooth pairing: use okama-cli bluetooth pair <mac>")
            elif opt == "Bluetooth":
                s = bt_mod.status()
                powered = s.get("powered", "no")
                if powered == "yes":
                    self._show_message(f"Bluetooth ON | Use okama-cli bluetooth pair <MAC>")
                else:
                    self._show_message("Bluetooth OFF. Enable in okama.conf")
            elif opt == "Network":
                net = self.net_monitor.get_status()
                if net["online"]:
                    conn = "WiFi" if net["type"] == "wifi" else "Ethernet"
                    self._show_message(f"ONLINE via {conn} | Updates available")
                else:
                    self._show_message("OFFLINE | Connect cable or enable WiFi")
            else:
                self._show_message(f"{opt} — coming in v1")

    def _power_input(self, action: str):
        n = len(POWER_OPTIONS)
        if action == "DPAD_DOWN":
            self.power_idx = (self.power_idx + 1) % n
        elif action == "DPAD_UP":
            self.power_idx = (self.power_idx - 1) % n
        elif action == "A":
            opt = POWER_OPTIONS[self.power_idx]
            if opt == "Restart":
                subprocess.call(["reboot"])
            elif opt == "Shut Down":
                subprocess.call(["poweroff"])
            elif opt == "Cancel":
                self.state = "home"
        elif action == "B":
            self.state = "home"

    # -----------------------------------------------------------------------
    # Drawing
    # -----------------------------------------------------------------------
    def _draw(self):
        # Draw animated cyberpunk background
        self.bg.draw(self.screen)

        if self.state == "home":
            self._draw_home()
        elif self.state == "play":
            self._draw_play()
        elif self.state == "settings":
            self._draw_settings()
        elif self.state == "power":
            self._draw_power()

        # Draw overlays
        self._draw_online_status()
        self._draw_update_badge()
        self._draw_message()
        self._draw_hints()

        if self.dev_mode:
            self._draw_debug_overlay()

        pygame.display.flip()

    def _draw_home(self):
        # Brand mark
        self._draw_logo(WIDTH // 2, 46, 1.0)

        # Section pills
        pill_w, pill_h = 200, 60
        total_w = len(SECTIONS) * pill_w + (len(SECTIONS) - 1) * 20
        start_x = WIDTH // 2 - total_w // 2
        y = HEIGHT // 2 - pill_h // 2

        for i, section in enumerate(SECTIONS):
            x = start_x + i * (pill_w + 20)
            color = COL_ACCENT if i == self.section_idx else COL_CARD
            pygame.draw.rect(self.screen, color, (x, y, pill_w, pill_h),
                             border_radius=12)
            if i == self.section_idx:
                pygame.draw.rect(self.screen, COL_ACCENT2,
                                 (x, y, pill_w, pill_h), 2, border_radius=12)
            label = self.font_md.render(section, True, COL_TEXT)
            self.screen.blit(label,
                (x + pill_w // 2 - label.get_width() // 2,
                 y + pill_h // 2 - label.get_height() // 2))

        # Sub-hint
        if SECTIONS[self.section_idx] == "Play":
            sub = self.font_sm.render(
                f"{len(self.games)} game(s) installed", True, COL_DIM)
            self.screen.blit(sub, (WIDTH // 2 - sub.get_width() // 2, y + 80))

        self._draw_update_notifications(y + 126)

    def _draw_update_notifications(self, y: int):
        if not self.update_check_done:
            label = self.font_sm.render("Checking for OS and game updates...",
                                        True, COL_DIM)
            self.screen.blit(label, (WIDTH // 2 - label.get_width() // 2, y))
            return

        if not self.update_notices:
            return

        os_count = sum(1 for n in self.update_notices if n.get("type") == "os")
        game_count = sum(1 for n in self.update_notices if n.get("type") == "game")
        parts = []
        if os_count:
            parts.append(f"{os_count} OS")
        if game_count:
            parts.append(f"{game_count} game")
        title = "Updates ready: " + " + ".join(parts)
        first = self.update_notices[0]
        detail = f"{first.get('name', first.get('id', 'Update'))} {first.get('version', '')}"
        if len(self.update_notices) > 1:
            detail += f" and {len(self.update_notices) - 1} more"

        card_w, card_h = 760, 88
        x = WIDTH // 2 - card_w // 2
        pygame.draw.rect(self.screen, COL_CARD, (x, y, card_w, card_h),
                         border_radius=12)
        pygame.draw.rect(self.screen, COL_OK, (x, y, card_w, card_h), 2,
                         border_radius=12)
        title_surf = self.font_md.render(title, True, COL_OK)
        detail_surf = self.font_sm.render(
            f"{detail} available. Run okama-update check for download links.",
            True, COL_TEXT)
        self.screen.blit(title_surf, (x + 22, y + 15))
        self.screen.blit(detail_surf, (x + 22, y + 52))

    def _draw_online_status(self):
        """Draw network connectivity indicator in top-right."""
        if not self.show_online_status:
            return
        net = self.net_monitor.get_status()
        if net["online"]:
            color = COL_NET_ONLINE
            if net["type"] == "wifi":
                icon = "WiFi"
            elif net["type"] == "ethernet":
                icon = "ETH"
            else:
                icon = "ON"
            text = f"{icon} ONLINE"
        else:
            color = COL_NET_OFFLINE
            text = "OFFLINE"

        surf = self.font_sm.render(text, True, color)
        x = WIDTH - surf.get_width() - 20
        y = 14
        # Small glow badge
        badge = pygame.Surface((surf.get_width() + 16, surf.get_height() + 8), pygame.SRCALPHA)
        badge.fill((*color, 40))
        self.screen.blit(badge, (x - 8, y - 4))
        self.screen.blit(surf, (x, y))

    def _draw_update_badge(self):
        """Draw update notification badge on home screen."""
        if self.state != "home" or not self.update_check_done or not self.update_notices:
            return
        total = len(self.update_notices)
        badge_text = f"{total} UPDATE{'S' if total > 1 else ''}"
        surf = self.font_sm.render(badge_text, True, COL_ACCENT3)
        x = 20
        y = 14
        badge = pygame.Surface((surf.get_width() + 16, surf.get_height() + 8), pygame.SRCALPHA)
        badge.fill((*COL_ACCENT3, 50))
        self.screen.blit(badge, (x - 8, y - 4))
        self.screen.blit(surf, (x, y))

    def _draw_play(self):
        title = self.font_lg.render("Play", True, COL_ACCENT2)
        self.screen.blit(title, (60, 40))

        if not self.games:
            msg = self.font_md.render(
                "No games installed.  Use okama-cli install <game.ok>",
                True, COL_DIM)
            self.screen.blit(msg, (60, HEIGHT // 2 - 20))
            return

        card_h = 80
        margin = 10
        start_y = 120

        for i, g in enumerate(self.games):
            y = start_y + i * (card_h + margin)
            if y + card_h > HEIGHT - 60:
                break
            color = COL_SELECTED if i == self.list_idx else COL_CARD
            pygame.draw.rect(self.screen, color, (40, y, WIDTH - 80, card_h),
                             border_radius=10)

            name = self.font_md.render(g["name"], True, COL_TEXT)
            ver  = self.font_sm.render(
                f"v{g.get('version','?')} · {g.get('id','')}", True, COL_DIM)
            self.screen.blit(name, (60, y + 12))
            self.screen.blit(ver,  (60, y + 46))

            if i == self.list_idx:
                hint = self.font_sm.render("[A] Launch", True, COL_OK)
                self.screen.blit(hint, (WIDTH - 160, y + 28))

    def _draw_settings(self):
        title = self.font_lg.render("Settings", True, COL_ACCENT2)
        self.screen.blit(title, (60, 40))

        for i, opt in enumerate(SETTINGS_OPTIONS):
            y = 120 + i * 64
            color = COL_SELECTED if i == self.settings_idx else COL_CARD
            pygame.draw.rect(self.screen, color, (40, y, WIDTH - 80, 52),
                             border_radius=8)
            label = self.font_md.render(opt, True, COL_TEXT)
            self.screen.blit(label, (60, y + 12))

    def _draw_power(self):
        title = self.font_lg.render("Power", True, COL_WARN)
        self.screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 120))

        for i, opt in enumerate(POWER_OPTIONS):
            y = 240 + i * 80
            color = COL_WARN if i == self.power_idx else COL_CARD
            pygame.draw.rect(self.screen, color,
                             (WIDTH // 2 - 150, y, 300, 60), border_radius=10)
            label = self.font_md.render(opt, True, COL_TEXT)
            self.screen.blit(label,
                (WIDTH // 2 - label.get_width() // 2, y + 15))

    def _draw_message(self):
        if self.message and self.message_timer > 0:
            alpha = min(255, self.message_timer * 12)
            surf = self.font_sm.render(self.message, True, COL_TEXT)
            bg = pygame.Surface((surf.get_width() + 24, surf.get_height() + 16),
                                 pygame.SRCALPHA)
            bg.fill((30, 30, 60, 200))
            self.screen.blit(bg, (WIDTH // 2 - bg.get_width() // 2, HEIGHT - 90))
            self.screen.blit(surf, (WIDTH // 2 - surf.get_width() // 2, HEIGHT - 82))

    def _draw_hints(self):
        hints = f"  {BUTTON_HINT_DPAD}   {BUTTON_HINT_A}   {BUTTON_HINT_B}   {BUTTON_HINT_START}   {BUTTON_HINT_L1R1}"
        h = self.font_hint.render(hints, True, COL_DIM)
        self.screen.blit(h, (20, HEIGHT - 28))

    def _draw_debug_overlay(self):
        try:
            with open("/proc/meminfo") as f:
                lines = {l.split(":")[0]: l.split(":")[1].strip()
                         for l in f if ":" in l}
            used = lines.get("MemTotal", "?")
            avail = lines.get("MemAvailable", "?")
            debug = f"DEV | RAM total:{used} avail:{avail} | FPS:{self.clock.get_fps():.0f}"
        except Exception:
            debug = f"DEV | FPS:{self.clock.get_fps():.0f}"

        surf = self.font_hint.render(debug, True, COL_WARN)
        self.screen.blit(surf, (WIDTH - surf.get_width() - 10, 6))


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
def main():
    p = argparse.ArgumentParser(prog="okama-shell")
    p.add_argument("--windowed", action="store_true",
                   help="Run in a window instead of fullscreen (dev/host use)")
    p.add_argument("--text", action="store_true",
                   help="Force text-mode shell (no Pygame)")
    args = p.parse_args()

    conf = cfg_mod.get()
    dev = conf.is_dev_mode()

    if args.text:
        _text_shell()
        return

    if not PYGAME_OK:
        message = f"OkamaOS GUI unavailable: pygame import failed: {PYGAME_IMPORT_ERROR}"
        print(message, file=sys.stderr)
        _log_shell_error(message)
        _text_shell()
        return

    _configure_sdl_environment(conf, args.windowed)

    try:
        pygame.display.init()
    except Exception as exc:
        message = f"pygame display initialization failed: {exc}"
        print(message, file=sys.stderr)
        print("Falling back to text shell.", file=sys.stderr)
        _log_shell_error(message)
        _text_shell()
        return

    # Try GUI shell with error handling for font/display issues
    try:
        shell = OkamaShell(windowed=args.windowed, dev_mode=dev)
        shell.run()
    except Exception as exc:
        try:
            pygame.quit()
        except Exception:
            pass
        message = f"OkamaOS GUI failed to start: {exc}"
        print(message, file=sys.stderr)
        print("Falling back to text shell.", file=sys.stderr)
        _log_shell_error(message)
        _text_shell()


if __name__ == "__main__":
    main()
