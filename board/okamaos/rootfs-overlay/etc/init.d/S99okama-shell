#!/bin/sh
# S99okama-shell — launch the guarded OkamaOS shell on tty1.
# The launcher owns crash handling and the safe framebuffer fallback.

case "$1" in
  start)
    echo "Launching okama-shell on tty1..."
    # Run on tty1 in the background (init will not wait for it)
    openvt -c 1 -f -w -- /usr/bin/okama-shell-launcher &
    ;;
  stop)
    killall okama-shell-launcher okama-safe-ui okama-shell 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
