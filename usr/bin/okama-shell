#!/usr/bin/env python3
"""okama-shell — OkamaOS fullscreen keyboard and controller UI shell.

Designed for Pygame on a framebuffer. No window manager, no desktop.
Keyboard and generic controllers are both first-class system input paths.

Boot flow: init → S99okama-shell → okama-shell (loops forever)
In-shell flow: home → navigate sections → launch game → game exits → home

Sections (MVP):
  Play | Settings | Power

Controller mapping (reads from okama-inputd socket):
  D-pad / LSTICK: navigate
  A: select
  B: back
  START: home
  HOME: quick-menu

Keyboard:
  Arrow keys / WASD: navigate, Enter / Space: select, Esc / Backspace: back
"""

import sys
import os
import glob

_lib = os.environ.get("OKAMA_LIB", "")
if not _lib:
    _lib = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../lib")
sys.path.insert(0, os.path.abspath(_lib))
for _pkg_dir in glob.glob("/usr/lib/python*/site-packages") + glob.glob("/usr/lib/python*/dist-packages"):
    if _pkg_dir not in sys.path:
        sys.path.append(_pkg_dir)

import subprocess
import time
import argparse
import threading
import queue
import select
import struct

# ---------------------------------------------------------------------------
# Pygame bootstrap — graceful degradation if not available
# ---------------------------------------------------------------------------
PYGAME_IMPORT_ERROR = None
try:
    import pygame
    PYGAME_OK = True
except Exception as exc:
    pygame = None
    PYGAME_OK = False
    PYGAME_IMPORT_ERROR = exc

from okamaos.input_protocol import InputClient
import okamaos.config as cfg_mod
import okamaos.games as games_mod
import okamaos.bluetooth as bt_mod
import okamaos.network as net_mod
import okamaos.updates as updates_mod

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
WIDTH, HEIGHT = 1280, 720
FPS = 30

COL_BG        = (6,   8,   18)
COL_GRID      = (31,  210, 190)
COL_GRID2     = (255, 76,  160)
COL_ACCENT    = (26,  132, 255)
COL_ACCENT2   = (255, 76,  160)
COL_TEXT      = (230, 230, 240)
COL_DIM       = (126, 138, 158)
COL_SELECTED  = (28,  74,  118)
COL_CARD      = (13,  20,  36)
COL_WARN      = (220, 100,  30)
COL_OK        = (60,  200,  80)
COL_ERROR     = (220,  50,  50)

SECTIONS = ["Play", "Settings", "Power"]
POWER_OPTIONS = ["Restart", "Shut Down", "Cancel"]
SETTINGS_OPTIONS = [
    "Input Devices",
    "Network",
    "Bluetooth",
    "Audio (placeholder)",
    "Updates",
    "Storage info",
    "Install to Disk",
]

BUTTON_HINT_A = "[A/Enter] Select"
BUTTON_HINT_B = "[B/Esc] Back"
BUTTON_HINT_DPAD = "[D-pad/Arrows/WASD] Move"
BUTTON_HINT_START = "[START] Home"

EVFMT = "llHHi"
EVSIZE = struct.calcsize(EVFMT)
EV_KEY = 1
EV_SYN = 0
EVIOCGBIT_BASE = 0x80000000 | (ord("E") << 8)

SHELL_KEYBOARD_MAP = {
    1: "B", 14: "B", 15: "SELECT", 28: "A", 57: "A",
    72: "DPAD_UP", 75: "DPAD_LEFT", 77: "DPAD_RIGHT", 80: "DPAD_DOWN",
    96: "A", 102: "START", 103: "DPAD_UP", 104: "DPAD_UP",
    105: "DPAD_LEFT", 106: "DPAD_RIGHT", 107: "DPAD_RIGHT",
    108: "DPAD_DOWN", 109: "DPAD_DOWN",
    17: "DPAD_UP", 30: "DPAD_LEFT", 31: "DPAD_DOWN",
    32: "DPAD_RIGHT", 35: "START",
}

HOME_DETAILS = {
    "Play": "Installed games and local packages",
    "Settings": "Network, Bluetooth, input, updates, install",
    "Power": "Restart, shut down, or return safely",
}


# ---------------------------------------------------------------------------
# Fallback text renderer (no Pygame)
# ---------------------------------------------------------------------------
def _text_shell():
    """Minimal text-mode shell for terminals / no-Pygame environments."""
    conf = cfg_mod.get()
    print("\n" + "=" * 48)
    print("  OkamaOS Shell  (text mode)")
    print("=" * 48)

    while True:
        games = games_mod.list_installed()
        print("\nInstalled games:")
        for i, g in enumerate(games):
            print(f"  [{i+1}] {g['name']} ({g['id']})")
        print("  [p] Power off")
        print("  [r] Reboot")
        print("  [q] Exit shell (dev mode only)")

        try:
            choice = input("\nSelect > ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            break

        if choice == "q":
            if conf.is_dev_mode():
                break
            print("Not in developer mode.")
        elif choice == "p":
            subprocess.call(["poweroff"])
        elif choice == "r":
            subprocess.call(["reboot"])
        elif choice.isdigit():
            idx = int(choice) - 1
            if 0 <= idx < len(games):
                gid = games[idx]["id"]
                os.execv("/usr/bin/okama-run", ["okama-run", gid])
            else:
                print("Invalid selection.")


def _log_shell_error(message: str):
    try:
        os.makedirs("/var/okamaos/logs", exist_ok=True)
        with open("/var/okamaos/logs/shell.log", "a", encoding="utf-8") as log:
            log.write(message + "\n")
    except Exception:
        pass


class ShellKeyboardReader(threading.Thread):
    """Local evdev reader used by the shell before SDL or inputd are ready."""

    def __init__(self):
        super().__init__(daemon=True)
        self._events = queue.Queue()
        self._stop_event = threading.Event()

    def poll(self) -> list:
        events = []
        while True:
            try:
                events.append(self._events.get_nowait())
            except queue.Empty:
                return events

    def run(self):
        workers = {}
        while not self._stop_event.is_set():
            for path, worker in list(workers.items()):
                if not worker.is_alive():
                    workers.pop(path, None)
            for path in sorted(glob.glob("/dev/input/event*")):
                if path in workers or not self._is_keyboard(path):
                    continue
                worker = threading.Thread(
                    target=self._read_device,
                    args=(path,),
                    daemon=True,
                )
                workers[path] = worker
                worker.start()
            time.sleep(2)

    def stop(self):
        self._stop_event.set()

    def _read_device(self, path: str):
        name = self._device_name(path)
        self._events.put({"type": "keyboard_connect", "name": name, "path": path})
        try:
            with open(path, "rb") as fd:
                while not self._stop_event.is_set():
                    r, _, _ = select.select([fd], [], [], 0.1)
                    if not r:
                        continue
                    data = fd.read(EVSIZE)
                    if len(data) < EVSIZE:
                        break
                    _, _, ev_type, code, value = struct.unpack(EVFMT, data)
                    if ev_type != EV_KEY or value not in (1, 2):
                        continue
                    action = SHELL_KEYBOARD_MAP.get(code)
                    if action:
                        self._events.put({
                            "src": "evdev-keyboard",
                            "action": action,
                            "path": path,
                        })
        except (PermissionError, FileNotFoundError, OSError) as exc:
            _log_shell_error(f"Keyboard reader skipped {path}: {exc}")

    def _is_keyboard(self, path: str) -> bool:
        name = self._device_name(path).lower()
        if "keyboard" in name or "kbd" in name:
            return True
        bits = self._ev_bits(path, EV_KEY, 96)
        nav_codes = (17, 30, 31, 32, 72, 75, 77, 80, 103, 105, 106, 108)
        action_codes = (1, 14, 15, 28, 57, 96, 102)
        has_nav = any(self._bit_is_set(bits, code) for code in nav_codes)
        has_action = any(self._bit_is_set(bits, code) for code in action_codes)
        mapped = sum(1 for code in SHELL_KEYBOARD_MAP if self._bit_is_set(bits, code))
        return has_nav and has_action and mapped >= 3

    def _device_name(self, path: str) -> str:
        event = os.path.basename(path)
        name_path = f"/sys/class/input/{event}/device/name"
        try:
            with open(name_path) as f:
                return f.read().strip()
        except OSError:
            return event

    def _ev_bits(self, path: str, ev_type: int, size: int) -> bytes:
        import fcntl
        request = EVIOCGBIT_BASE | (size << 16) | (0x20 + ev_type)
        buf = bytearray(size)
        try:
            with open(path, "rb") as fd:
                fcntl.ioctl(fd, request, buf)
            return bytes(buf)
        except OSError:
            return b""

    def _bit_is_set(self, bits: bytes, bit: int) -> bool:
        idx = bit // 8
        if idx >= len(bits):
            return False
        return bool(bits[idx] & (1 << (bit % 8)))


# ---------------------------------------------------------------------------
# Pygame shell
# ---------------------------------------------------------------------------
class OkamaShell:
    def __init__(self, windowed: bool = False, dev_mode: bool = False):
        self.windowed = windowed
        self.dev_mode = dev_mode
        self.conf = cfg_mod.get()

        flags = 0 if windowed else pygame.FULLSCREEN | pygame.NOFRAME
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT), flags)
        pygame.display.set_caption("OkamaOS")
        pygame.mouse.set_visible(False)
        pygame.key.set_repeat(260, 90)

        self.clock = pygame.time.Clock()
        self._init_fonts()
        self.background = self._build_background()

        self.input_client = InputClient()
        self.input_client.connect()
        self._last_input_connect_attempt = 0.0
        self.keyboard_reader = ShellKeyboardReader()
        self.keyboard_reader.start()

        self.state = "home"       # home | play | settings | power | launching
        self.section_idx = 0
        self.list_idx = 0
        self.settings_idx = 0
        self.power_idx = 0
        self.message = ""
        self.message_timer = 0
        self.update_notices = []
        self.update_check_done = False
        self.update_check_error = ""
        self.network_status = {
            "online": "no",
            "internet": "unknown",
            "summary": "checking network",
            "interfaces": [],
        }
        self.bluetooth_status = {
            "available": "unknown",
            "powered": "unknown",
            "connected_count": 0,
        }
        self.input_devices = {}
        self._status_lock = threading.Lock()

        self.games = []
        self._refresh_games()

        self._input_cooldown = 0
        self._axis_threshold = 0.5
        self._axis_held: dict = {}
        self._last_action_at: dict[str, float] = {}
        self._start_update_check()
        self._start_status_loop()

    def _init_fonts(self):
        pygame.font.init()
        try:
            self.font_xl  = pygame.font.SysFont("DejaVu Sans", 72, bold=True)
            self.font_lg  = pygame.font.SysFont("DejaVu Sans", 42, bold=True)
            self.font_md  = pygame.font.SysFont("DejaVu Sans", 28)
            self.font_sm  = pygame.font.SysFont("DejaVu Sans", 20)
            self.font_hint= pygame.font.SysFont("DejaVu Sans", 18)
        except Exception:
            default = pygame.font.Font(None, 36)
            self.font_xl = self.font_lg = self.font_md = \
                self.font_sm = self.font_hint = default

    def _build_background(self):
        surf = pygame.Surface((WIDTH, HEIGHT))
        for y in range(HEIGHT):
            t = y / HEIGHT
            base = (
                int(5 + 5 * t),
                int(8 + 16 * t),
                int(18 + 20 * t),
            )
            pygame.draw.line(surf, base, (0, y), (WIDTH, y))

        horizon = int(HEIGHT * 0.42)
        for y in range(horizon, HEIGHT, 28):
            depth = (y - horizon) / max(1, HEIGHT - horizon)
            alpha = int(35 + depth * 130)
            color = (*COL_GRID, min(alpha, 180))
            line = pygame.Surface((WIDTH, 2), pygame.SRCALPHA)
            line.fill(color)
            surf.blit(line, (0, y))

        vanish_x = WIDTH // 2
        for x in range(-WIDTH, WIDTH * 2, 80):
            color = COL_GRID if (x // 80) % 2 == 0 else COL_GRID2
            pygame.draw.line(surf, color, (vanish_x, horizon), (x, HEIGHT), 1)

        fence_top = 118
        fence_bottom = horizon + 22
        for x in range(0, WIDTH + 1, 56):
            pygame.draw.line(surf, (38, 78, 92), (x, fence_top),
                             (x + 40, fence_bottom), 1)
        for y in range(fence_top, fence_bottom, 34):
            pygame.draw.line(surf, (72, 60, 95), (0, y),
                             (WIDTH, y + 16), 1)
        haze = pygame.Surface((WIDTH, 110), pygame.SRCALPHA)
        for y in range(110):
            haze.fill((10, 18, 34, max(0, 70 - y)), rect=(0, y, WIDTH, 1))
        surf.blit(haze, (0, fence_bottom - 34))
        return surf.convert()

    def _draw_logo(self, center_x: int, y: int, scale: float = 1.0):
        width = int(520 * scale)
        mark_w = int(112 * scale)
        mark_h = int(82 * scale)
        x = center_x - width // 2

        pygame.draw.rect(self.screen, COL_TEXT, (x, y, mark_w, mark_h),
                         border_radius=max(3, int(5 * scale)))
        inset = max(6, int(9 * scale))
        pygame.draw.rect(self.screen, COL_BG,
                         (x + inset, y + inset, mark_w - inset * 2,
                          mark_h - inset * 3), border_radius=2)
        pygame.draw.circle(self.screen, COL_OK,
                           (x + int(34 * scale), y + int(34 * scale)),
                           max(5, int(9 * scale)))
        pygame.draw.rect(self.screen, COL_WARN,
                         (x + int(56 * scale), y + int(27 * scale),
                          int(35 * scale), max(4, int(5 * scale))))
        pygame.draw.rect(self.screen, COL_ACCENT2,
                         (x + int(56 * scale), y + int(43 * scale),
                          int(26 * scale), max(4, int(5 * scale))))
        pygame.draw.rect(self.screen, COL_TEXT,
                         (x + int(18 * scale), y + int(91 * scale),
                          int(76 * scale), int(15 * scale)))

        logo = self.font_xl.render("OkamaOS", True, COL_TEXT)
        word_x = x + mark_w + int(28 * scale)
        self.screen.blit(logo, (word_x, y + int(3 * scale)))
        wave = self.font_sm.render("FIRST WAVE", True, COL_OK)
        self.screen.blit(wave, (word_x + int(6 * scale),
                                y + int(72 * scale)))

    def _refresh_games(self):
        self.games = games_mod.list_installed()

    def _show_message(self, msg: str, duration: float = 2.5):
        self.message = msg
        self.message_timer = int(duration * FPS)

    def _start_update_check(self):
        if self.conf.get("UPDATE_CHECK_ENABLED", "yes").lower() != "yes":
            self.update_check_done = True
            return

        def worker():
            notices, error = updates_mod.check_all(installed=self.games)
            self.update_notices = notices
            self.update_check_error = error or ""
            self.update_check_done = True

        threading.Thread(target=worker, daemon=True).start()

    def _start_status_loop(self):
        def worker():
            while True:
                net_status = net_mod.status()
                bt_status = bt_mod.status()
                with self._status_lock:
                    self.network_status = net_status
                    self.bluetooth_status = bt_status
                time.sleep(8)

        threading.Thread(target=worker, daemon=True).start()

    def run(self):
        running = True
        while running:
            dt = self.clock.tick(FPS)
            events = self._collect_events()

            for e in events:
                if e.get("type") == "QUIT":
                    running = False

            self._handle_input(events)

            self._draw()

            if self.message_timer > 0:
                self.message_timer -= 1

        self.keyboard_reader.stop()
        self.input_client.close()
        pygame.quit()

    # -----------------------------------------------------------------------
    # Input collection (controller socket + direct keyboard)
    # -----------------------------------------------------------------------
    def _collect_events(self) -> list:
        events = []

        direct_keyboard_actions = set()
        for pev in pygame.event.get():
            if pev.type == pygame.QUIT:
                events.append({"type": "QUIT"})
            elif pev.type == pygame.KEYDOWN:
                action = self._map_keyboard_action(pev.key)
                if action == "QUIT":
                    events.append({"type": "QUIT"})
                elif action:
                    events.append({"src": "keyboard", "action": action})
                    direct_keyboard_actions.add(action)

        for ev in self.keyboard_reader.poll():
            if ev.get("type") == "keyboard_connect":
                self.input_devices[f"shell:{ev.get('path')}"] = {
                    "bus": "keyboard",
                    "name": ev.get("name", "keyboard"),
                    "path": ev.get("path", ""),
                }
                continue
            action = ev.get("action")
            if action:
                if self._recent_action(action, 0.08):
                    continue
                events.append(ev)
                direct_keyboard_actions.add(action)

        self._ensure_input_connected()
        for ev in self.input_client.poll():
            ev_type = ev.get("type")
            controller = ev.get("controller")
            if ev_type == "connect":
                self.input_devices[str(controller)] = ev
                continue
            if ev_type == "disconnect":
                self.input_devices.pop(str(controller), None)
                continue
            if ev_type == "button" and ev.get("state") == "pressed":
                action = ev.get("button")
                if controller == -1 and action in direct_keyboard_actions:
                    continue
                src = "keyboard" if controller == -1 else "controller"
                events.append({"src": src, "action": action})
            elif ev_type == "axis":
                self._handle_axis_to_dpad(ev, events)

        return events

    def _ensure_input_connected(self):
        if self.input_client.connected:
            return
        now = time.monotonic()
        if now - self._last_input_connect_attempt < 1.0:
            return
        self._last_input_connect_attempt = now
        self.input_client.connect()

    def _recent_action(self, action: str, window: float) -> bool:
        now = time.monotonic()
        last = self._last_action_at.get(action, 0.0)
        if now - last < window:
            return True
        self._last_action_at[action] = now
        return False

    def _map_keyboard_action(self, key: int) -> str | None:
        mapping = {
            pygame.K_UP: "DPAD_UP",
            pygame.K_w: "DPAD_UP",
            pygame.K_DOWN: "DPAD_DOWN",
            pygame.K_s: "DPAD_DOWN",
            pygame.K_LEFT: "DPAD_LEFT",
            pygame.K_a: "DPAD_LEFT",
            pygame.K_RIGHT: "DPAD_RIGHT",
            pygame.K_d: "DPAD_RIGHT",
            pygame.K_RETURN: "A",
            pygame.K_KP_ENTER: "A",
            pygame.K_SPACE: "A",
            pygame.K_ESCAPE: "B",
            pygame.K_BACKSPACE: "B",
            pygame.K_TAB: "SELECT",
            pygame.K_HOME: "START",
            pygame.K_h: "START",
            pygame.K_q: "QUIT" if self.dev_mode else None,
        }
        return mapping.get(key)

    def _handle_axis_to_dpad(self, ev: dict, out: list):
        axis = ev.get("axis", "")
        value = ev.get("value", 0.0)
        prev = self._axis_held.get(axis, 0.0)

        if axis in ("LSTICK_Y", "RSTICK_Y"):
            if value < -self._axis_threshold and prev >= -self._axis_threshold:
                out.append({"src": "axis", "action": "DPAD_UP"})
            elif value > self._axis_threshold and prev <= self._axis_threshold:
                out.append({"src": "axis", "action": "DPAD_DOWN"})
        elif axis in ("LSTICK_X", "RSTICK_X"):
            if value < -self._axis_threshold and prev >= -self._axis_threshold:
                out.append({"src": "axis", "action": "DPAD_LEFT"})
            elif value > self._axis_threshold and prev <= self._axis_threshold:
                out.append({"src": "axis", "action": "DPAD_RIGHT"})

        self._axis_held[axis] = value

    # -----------------------------------------------------------------------
    # State machine
    # -----------------------------------------------------------------------
    def _handle_input(self, events: list):
        if self._input_cooldown > 0:
            self._input_cooldown -= 1
            return

        for ev in events:
            action = ev.get("action")
            if not action:
                continue
            self._input_cooldown = 4  # ~130ms at 30 fps
            self._dispatch(action)
            return

    def _dispatch(self, action: str):
        if action == "HOME":
            action = "START"
        if self.state == "home":
            self._home_input(action)
        elif self.state == "play":
            self._play_input(action)
        elif self.state == "settings":
            self._settings_input(action)
        elif self.state == "power":
            self._power_input(action)

    def _home_input(self, action: str):
        n = len(SECTIONS)
        if action in ("DPAD_RIGHT", "DPAD_DOWN"):
            self.section_idx = (self.section_idx + 1) % n
        elif action in ("DPAD_LEFT", "DPAD_UP"):
            self.section_idx = (self.section_idx - 1) % n
        elif action == "A":
            section = SECTIONS[self.section_idx]
            if section == "Play":
                self._refresh_games()
                self.list_idx = 0
                self.state = "play"
            elif section == "Settings":
                self.settings_idx = 0
                self.state = "settings"
            elif section == "Power":
                self.power_idx = 0
                self.state = "power"

    def _play_input(self, action: str):
        n = len(self.games)
        if action == "B" or action == "START":
            self.state = "home"
        elif action == "DPAD_DOWN":
            if n:
                self.list_idx = (self.list_idx + 1) % n
        elif action == "DPAD_UP":
            if n:
                self.list_idx = (self.list_idx - 1) % n
        elif action == "A":
            if self.games:
                self._launch_game(self.games[self.list_idx])

    def _launch_game(self, game: dict):
        gid = game["id"]
        self._show_message(f"Launching {game['name']}…")
        self._draw()
        pygame.display.flip()
        time.sleep(0.5)
        pygame.quit()
        os.execv("/usr/bin/okama-run", ["okama-run", gid])

    def _settings_input(self, action: str):
        n = len(SETTINGS_OPTIONS)
        if action == "B" or action == "START":
            self.state = "home"
        elif action == "DPAD_DOWN":
            self.settings_idx = (self.settings_idx + 1) % n
        elif action == "DPAD_UP":
            self.settings_idx = (self.settings_idx - 1) % n
        elif action == "A":
            opt = SETTINGS_OPTIONS[self.settings_idx]
            if opt == "Input Devices":
                self._show_message(self._input_summary())
            elif opt == "Network":
                with self._status_lock:
                    s = dict(self.network_status)
                self._show_message(s.get("summary", "network status unknown"))
            elif opt == "Bluetooth":
                with self._status_lock:
                    s = dict(self.bluetooth_status)
                if s.get("available") == "yes":
                    self._show_message(
                        f"Bluetooth {s.get('powered', 'unknown')}; "
                        f"{s.get('connected_count', 0)} connected")
                else:
                    self._show_message("Bluetooth adapter/service unavailable")
            elif opt == "Updates":
                if not self.update_check_done:
                    self._show_message("Update check still running")
                elif self.update_notices:
                    self._show_message(f"{len(self.update_notices)} update(s) available")
                else:
                    self._show_message("No updates available")
            elif opt == "Install to Disk":
                self._show_message("Use okama-install --list-disks, then --target /dev/sdX")
            else:
                self._show_message(f"{opt} status ready")

    def _input_summary(self) -> str:
        keyboard = any(d.get("bus") == "keyboard" for d in self.input_devices.values())
        controllers = [
            d for d in self.input_devices.values()
            if d.get("bus") != "keyboard" and d.get("controller") != -1
        ]
        keyboard_text = "kbd: ready" if keyboard or self.input_client.connected else "kbd: direct"
        return f"{keyboard_text}, pads: {len(controllers)}"

    def _power_input(self, action: str):
        n = len(POWER_OPTIONS)
        if action == "DPAD_DOWN":
            self.power_idx = (self.power_idx + 1) % n
        elif action == "DPAD_UP":
            self.power_idx = (self.power_idx - 1) % n
        elif action == "A":
            opt = POWER_OPTIONS[self.power_idx]
            if opt == "Restart":
                subprocess.call(["reboot"])
            elif opt == "Shut Down":
                subprocess.call(["poweroff"])
            elif opt == "Cancel":
                self.state = "home"
        elif action == "B" or action == "START":
            self.state = "home"

    # -----------------------------------------------------------------------
    # Drawing
    # -----------------------------------------------------------------------
    def _draw(self):
        self.screen.blit(self.background, (0, 0))
        self._draw_status_bar()

        if self.state == "home":
            self._draw_home()
        elif self.state == "play":
            self._draw_play()
        elif self.state == "settings":
            self._draw_settings()
        elif self.state == "power":
            self._draw_power()

        self._draw_message()
        self._draw_hints()

        if self.dev_mode:
            self._draw_debug_overlay()

        pygame.display.flip()

    def _draw_home(self):
        # Brand mark
        self._draw_logo(WIDTH // 2, 58, 0.92)

        panel_x = 140
        panel_y = 210
        panel_w = 1000
        row_h = 86
        gap = 14
        for i, section in enumerate(SECTIONS):
            y = panel_y + i * (row_h + gap)
            selected = i == self.section_idx
            color = (18, 32, 56) if selected else COL_CARD
            border = COL_ACCENT if selected else (36, 58, 82)
            pygame.draw.rect(self.screen, color,
                             (panel_x, y, panel_w, row_h), border_radius=8)
            pygame.draw.rect(self.screen, border,
                             (panel_x, y, panel_w, row_h), 2, border_radius=8)
            marker_color = COL_ACCENT2 if selected else (48, 82, 102)
            pygame.draw.rect(self.screen, marker_color,
                             (panel_x, y, 8, row_h), border_radius=4)
            label = self.font_lg.render(section, True, COL_TEXT)
            detail = self.font_sm.render(HOME_DETAILS.get(section, ""),
                                         True, COL_DIM)
            self.screen.blit(label, (panel_x + 34, y + 12))
            self.screen.blit(detail, (panel_x + 36, y + 56))

            if selected:
                indicator = self.font_md.render(">", True, COL_ACCENT2)
                self.screen.blit(indicator, (panel_x + panel_w - 42, y + 26))

        self._draw_home_status(panel_x, panel_y + len(SECTIONS) * (row_h + gap) + 14,
                               panel_w)
        self._draw_update_notifications(panel_y + 420)

    def _draw_home_status(self, x: int, y: int, w: int):
        with self._status_lock:
            net = dict(self.network_status)
            bt = dict(self.bluetooth_status)
        items = [
            ("Games", str(len(self.games))),
            ("Network", "online" if net.get("online") == "yes" else "offline"),
            ("Bluetooth", "ready" if bt.get("available") == "yes" else "off"),
            ("Input", self._input_summary()),
        ]
        col_w = w // len(items)
        for i, (label, value) in enumerate(items):
            ix = x + i * col_w
            pygame.draw.rect(self.screen, (8, 18, 30),
                             (ix, y, col_w - 10, 58), border_radius=8)
            pygame.draw.rect(self.screen, (32, 74, 92),
                             (ix, y, col_w - 10, 58), 1, border_radius=8)
            label_surf = self.font_hint.render(label, True, COL_DIM)
            value_surf = self.font_sm.render(value, True, COL_TEXT)
            self.screen.blit(label_surf, (ix + 16, y + 9))
            self.screen.blit(value_surf, (ix + 16, y + 30))

    def _draw_update_notifications(self, y: int):
        if not self.update_check_done:
            label = self.font_sm.render("Checking for OS and game updates...",
                                        True, COL_DIM)
            self.screen.blit(label, (WIDTH // 2 - label.get_width() // 2, y))
            return

        if not self.update_notices:
            return

        os_count = sum(1 for n in self.update_notices if n.get("type") == "os")
        game_count = sum(1 for n in self.update_notices if n.get("type") == "game")
        parts = []
        if os_count:
            parts.append(f"{os_count} OS")
        if game_count:
            parts.append(f"{game_count} game")
        title = "Updates ready: " + " + ".join(parts)
        first = self.update_notices[0]
        detail = f"{first.get('name', first.get('id', 'Update'))} {first.get('version', '')}"
        if len(self.update_notices) > 1:
            detail += f" and {len(self.update_notices) - 1} more"

        card_w, card_h = 760, 88
        x = WIDTH // 2 - card_w // 2
        pygame.draw.rect(self.screen, COL_CARD, (x, y, card_w, card_h),
                         border_radius=8)
        pygame.draw.rect(self.screen, COL_OK, (x, y, card_w, card_h), 2,
                         border_radius=8)
        title_surf = self.font_md.render(title, True, COL_OK)
        detail_surf = self.font_sm.render(
            f"{detail} available. Run okama-update check for download links.",
            True, COL_TEXT)
        self.screen.blit(title_surf, (x + 22, y + 15))
        self.screen.blit(detail_surf, (x + 22, y + 52))

    def _draw_play(self):
        title = self.font_lg.render("Play", True, COL_ACCENT2)
        self.screen.blit(title, (60, 40))

        if not self.games:
            msg = self.font_md.render(
                "No games installed.  Use okama-cli install <game.ok>",
                True, COL_DIM)
            self.screen.blit(msg, (60, HEIGHT // 2 - 20))
            return

        card_h = 80
        margin = 10
        start_y = 120

        for i, g in enumerate(self.games):
            y = start_y + i * (card_h + margin)
            if y + card_h > HEIGHT - 60:
                break
            color = COL_SELECTED if i == self.list_idx else COL_CARD
            pygame.draw.rect(self.screen, color, (40, y, WIDTH - 80, card_h),
                             border_radius=8)

            name = self.font_md.render(g["name"], True, COL_TEXT)
            ver  = self.font_sm.render(
                f"v{g.get('version','?')} · {g.get('id','')}", True, COL_DIM)
            self.screen.blit(name, (60, y + 12))
            self.screen.blit(ver,  (60, y + 46))

            if i == self.list_idx:
                hint = self.font_sm.render("[A] Launch", True, COL_OK)
                self.screen.blit(hint, (WIDTH - 160, y + 28))

    def _draw_settings(self):
        title = self.font_lg.render("Settings", True, COL_ACCENT2)
        self.screen.blit(title, (60, 40))

        for i, opt in enumerate(SETTINGS_OPTIONS):
            y = 116 + i * 70
            color = COL_SELECTED if i == self.settings_idx else COL_CARD
            pygame.draw.rect(self.screen, color, (40, y, WIDTH - 80, 58),
                             border_radius=8)
            label = self.font_md.render(opt, True, COL_TEXT)
            detail, detail_color = self._settings_detail(opt)
            detail_surf = self.font_sm.render(detail, True, detail_color)
            self.screen.blit(label, (60, y + 7))
            self.screen.blit(detail_surf, (60, y + 34))

    def _draw_power(self):
        title = self.font_lg.render("Power", True, COL_WARN)
        self.screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 120))

        for i, opt in enumerate(POWER_OPTIONS):
            y = 240 + i * 80
            color = COL_WARN if i == self.power_idx else COL_CARD
            pygame.draw.rect(self.screen, color,
                             (WIDTH // 2 - 150, y, 300, 60), border_radius=8)
            label = self.font_md.render(opt, True, COL_TEXT)
            self.screen.blit(label,
                (WIDTH // 2 - label.get_width() // 2, y + 15))

    def _draw_message(self):
        if self.message and self.message_timer > 0:
            alpha = min(255, self.message_timer * 12)
            surf = self.font_sm.render(self.message, True, COL_TEXT)
            bg = pygame.Surface((surf.get_width() + 24, surf.get_height() + 16),
                                 pygame.SRCALPHA)
            bg.fill((30, 30, 60, 200))
            self.screen.blit(bg, (WIDTH // 2 - bg.get_width() // 2, HEIGHT - 90))
            self.screen.blit(surf, (WIDTH // 2 - surf.get_width() // 2, HEIGHT - 82))

    def _draw_hints(self):
        hints = f"  {BUTTON_HINT_DPAD}   {BUTTON_HINT_A}   {BUTTON_HINT_B}   {BUTTON_HINT_START}"
        h = self.font_hint.render(hints, True, COL_DIM)
        self.screen.blit(h, (20, HEIGHT - 28))

    def _draw_status_bar(self):
        with self._status_lock:
            net_status = dict(self.network_status)
            bt_status = dict(self.bluetooth_status)
        online = net_status.get("online") == "yes"
        update_label = "updates: checking"
        update_color = COL_DIM
        if self.update_check_done:
            if self.update_notices:
                update_label = f"updates: {len(self.update_notices)}"
                update_color = COL_ACCENT2
            else:
                update_label = "updates: current"
                update_color = COL_OK
        input_label = self._input_summary()
        bt_label = "bt: ready" if bt_status.get("available") == "yes" else "bt: off"
        labels = [
            (f"v{self.conf.get('VERSION', '?')}", COL_TEXT),
            ("online" if online else "offline", COL_OK if online else COL_ERROR),
            (update_label, update_color),
            (bt_label, COL_OK if bt_status.get("powered") == "yes" else COL_DIM),
            (input_label, COL_TEXT),
        ]
        x = 16
        for label, color in labels:
            x = self._draw_badge(label, x, 12, color) + 8

    def _draw_badge(self, label: str, x: int, y: int, color):
        text = self.font_hint.render(label, True, color)
        w = text.get_width() + 20
        h = 28
        bg = pygame.Surface((w, h), pygame.SRCALPHA)
        bg.fill((6, 12, 22, 190))
        self.screen.blit(bg, (x, y))
        pygame.draw.rect(self.screen, color, (x, y, w, h), 1, border_radius=6)
        self.screen.blit(text, (x + 10, y + 5))
        return x + w

    def _settings_detail(self, opt: str) -> tuple[str, tuple]:
        if opt == "Input Devices":
            return self._input_summary(), COL_OK
        if opt == "Network":
            with self._status_lock:
                s = dict(self.network_status)
            color = COL_OK if s.get("online") == "yes" else COL_ERROR
            return s.get("summary", "status unavailable"), color
        if opt == "Bluetooth":
            with self._status_lock:
                s = dict(self.bluetooth_status)
            if s.get("available") == "yes":
                return (
                    f"powered {s.get('powered', 'unknown')}; "
                    f"{s.get('connected_count', 0)} connected",
                    COL_OK if s.get("powered") == "yes" else COL_WARN,
                )
            return "adapter or bluetoothctl unavailable", COL_DIM
        if opt == "Updates":
            if not self.update_check_done:
                return "checking public OS and game feeds", COL_DIM
            if self.update_notices:
                return f"{len(self.update_notices)} OS/game update(s) available", COL_ACCENT2
            if self.update_check_error:
                return self.update_check_error[:80], COL_WARN
            return "OS and installed games are current", COL_OK
        if opt == "Install to Disk":
            return "okama-install is available for hard-drive installs", COL_OK
        if opt == "Storage info":
            return "games, saves, and updates preserved by installer/update paths", COL_DIM
        return "ALSA output active when hardware is present", COL_DIM

    def _draw_debug_overlay(self):
        try:
            with open("/proc/meminfo") as f:
                lines = {l.split(":")[0]: l.split(":")[1].strip()
                         for l in f if ":" in l}
            used = lines.get("MemTotal", "?")
            avail = lines.get("MemAvailable", "?")
            debug = f"DEV | RAM total:{used} avail:{avail} | FPS:{self.clock.get_fps():.0f}"
        except Exception:
            debug = f"DEV | FPS:{self.clock.get_fps():.0f}"

        surf = self.font_hint.render(debug, True, COL_WARN)
        self.screen.blit(surf, (WIDTH - surf.get_width() - 10, 6))


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
def main():
    p = argparse.ArgumentParser(prog="okama-shell")
    p.add_argument("--windowed", action="store_true",
                   help="Run in a window instead of fullscreen (dev/host use)")
    p.add_argument("--text", action="store_true",
                   help="Force text-mode shell (no Pygame)")
    args = p.parse_args()

    conf = cfg_mod.get()
    dev = conf.is_dev_mode()

    if args.text:
        _text_shell()
        return

    if not PYGAME_OK:
        message = f"OkamaOS GUI unavailable: pygame import failed: {PYGAME_IMPORT_ERROR}"
        print(message, file=sys.stderr)
        _log_shell_error(message)
        _text_shell()
        return

    os.environ.setdefault("SDL_VIDEODRIVER", "kmsdrm")
    os.environ.setdefault("SDL_KMSDRM_REQUIRE_DRM_MASTER", "0")
    os.environ.setdefault("SDL_FBDEV",
                          conf.get("FRAMEBUFFER_DEVICE", "/dev/fb0"))
    os.environ.setdefault("SDL_AUDIODRIVER", "alsa")

    if args.windowed:
        os.environ["SDL_VIDEODRIVER"] = "x11"  # dev host

    try:
        pygame.init()
        shell = OkamaShell(windowed=args.windowed, dev_mode=dev)
        shell.run()
    except Exception as exc:
        try:
            pygame.quit()
        except Exception:
            pass
        message = f"OkamaOS GUI failed to start: {exc}"
        print(message, file=sys.stderr)
        print("Falling back to text shell.", file=sys.stderr)
        _log_shell_error(message)
        _text_shell()


if __name__ == "__main__":
    main()
