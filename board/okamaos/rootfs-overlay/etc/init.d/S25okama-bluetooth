#!/bin/sh
# S25okama-bluetooth — start BlueZ for plug-and-play HID controllers.
# BLUETOOTH_ENABLED=yes or auto starts the service when bluetoothd exists.
# Existing trusted controller profiles are reconnected after the adapter powers on.

CONF=/etc/okamaos/okama.conf
CONTROLLERS_DIR=/var/okamaos/controllers
BT_ENABLED=auto

# Read config
if [ -f "$CONF" ]; then
    BT_ENABLED=$(grep '^BLUETOOTH_ENABLED=' "$CONF" | cut -d= -f2 | tr -d '[:space:]')
fi

# Auto-enable if paired controllers exist
if [ -d "$CONTROLLERS_DIR" ] && ls "$CONTROLLERS_DIR"/*.json 2>/dev/null | grep -q .; then
    BT_ENABLED=yes
fi

case "$1" in
  start)
    if [ "$BT_ENABLED" = "yes" ] || [ "$BT_ENABLED" = "auto" ]; then
        echo "Starting Bluetooth (bluetoothd)..."
        if which bluetoothd >/dev/null 2>&1; then
            if which dbus-daemon >/dev/null 2>&1 && [ ! -S /var/run/dbus/system_bus_socket ]; then
                mkdir -p /var/run/dbus
                dbus-daemon --system --fork >/dev/null 2>&1 || true
            fi
            bluetoothd &
            sleep 1
            if which bluetoothctl >/dev/null 2>&1; then
                bluetoothctl power on >/dev/null 2>&1 || true
                bluetoothctl agent on >/dev/null 2>&1 || true
                bluetoothctl default-agent >/dev/null 2>&1 || true
                for f in "$CONTROLLERS_DIR"/*.json; do
                    [ -f "$f" ] || continue
                    MAC=$(python3 -c "import json,sys; d=json.load(open('$f')); print(d.get('mac',''))" 2>/dev/null)
                    [ -n "$MAC" ] && bluetoothctl connect "$MAC" >/dev/null 2>&1 &
                done
            fi
        else
            echo "bluetoothd not found — Bluetooth unavailable."
        fi
    else
        echo "Bluetooth disabled in config — skipping."
    fi
    ;;
  stop)
    killall bluetoothd 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
