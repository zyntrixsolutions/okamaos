#!/usr/bin/env python3
"""okama-inputd — OkamaOS controller input daemon.

Reads raw evdev events from USB and Bluetooth HID gamepads, normalises them
through the controller profile map, and broadcasts Okama unified input events
as newline-delimited JSON to a Unix domain socket.

Architecture:
  - One thread per /dev/input/eventN device
  - Main thread accepts socket connections and fans out events to all clients
  - Hot-plug handled via inotify on /dev/input (or polling fallback)
  - Keyboard treated as secondary; only emits events in dev/fallback mode

Usage (daemon mode — called by init script):
  okama-inputd --daemon

Usage (interactive test):
  okama-inputd --test
"""

import sys
import os

_lib = os.environ.get("OKAMA_LIB", "")
if not _lib:
    _lib = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../lib")
sys.path.insert(0, os.path.abspath(_lib))

import argparse
import json
import socket
import threading
import time
import struct
import glob
import select
import logging

from okamaos.input_protocol import SOCKET_PATH, BUTTONS, AXES
import okamaos.config as cfg_mod

LOG_PATH = "/var/okamaos/logs/okama-inputd.log"

logging.basicConfig(
    level=logging.WARNING,
    format="%(asctime)s [okama-inputd] %(levelname)s %(message)s",
    handlers=[logging.StreamHandler(sys.stderr)],
)
log = logging.getLogger("okama-inputd")

# evdev event struct: (time_sec, time_usec, type, code, value)  — 24 bytes
EVFMT = "llHHi"
EVSIZE = struct.calcsize(EVFMT)

EV_SYN  = 0
EV_KEY  = 1
EV_ABS  = 3
EV_MSC  = 4

KEYBOARD_STALE_RELEASE_SEC = 0.30
AXIS_CHANGE_EPSILON = 0.04

# evdev ABS axis indices
ABS_X    = 0
ABS_Y    = 1
ABS_RX   = 3
ABS_RY   = 4
ABS_HAT0X = 16
ABS_HAT0Y = 17
ABS_Z    = 2   # L2 trigger
ABS_RZ   = 5   # R2 trigger
ABS_GAS   = 9
ABS_BRAKE = 10

BTN_A      = 0x130  # BTN_SOUTH
BTN_B      = 0x131  # BTN_EAST
BTN_X      = 0x133  # BTN_WEST (note: raw codes vary by driver)
BTN_Y      = 0x134  # BTN_NORTH
BTN_TL     = 0x136
BTN_TR     = 0x137
BTN_TL2    = 0x138
BTN_TR2    = 0x139
BTN_SELECT = 0x13a
BTN_START  = 0x13b
BTN_MODE   = 0x13c  # HOME / Guide
BTN_DPAD_UP    = 0x220
BTN_DPAD_DOWN  = 0x221
BTN_DPAD_LEFT  = 0x222
BTN_DPAD_RIGHT = 0x223

BUTTON_MAP = {
    0x130: "A",
    0x131: "B",
    0x133: "X",
    0x134: "Y",
    0x136: "L1",
    0x137: "R1",
    0x138: "L2",
    0x139: "R2",
    0x13a: "SELECT",
    0x13b: "START",
    0x13c: "HOME",
    0x13d: "L3",
    0x13e: "R3",
    BTN_DPAD_UP: "DPAD_UP",
    BTN_DPAD_DOWN: "DPAD_DOWN",
    BTN_DPAD_LEFT: "DPAD_LEFT",
    BTN_DPAD_RIGHT: "DPAD_RIGHT",
}

KEYBOARD_BUTTON_MAP = {
    103: "DPAD_UP",     # KEY_UP
    108: "DPAD_DOWN",   # KEY_DOWN
    105: "DPAD_LEFT",   # KEY_LEFT
    106: "DPAD_RIGHT",  # KEY_RIGHT
    17: "DPAD_UP",      # KEY_W
    31: "DPAD_DOWN",    # KEY_S
    30: "DPAD_LEFT",    # KEY_A
    32: "DPAD_RIGHT",   # KEY_D
    28: "A",            # KEY_ENTER
    57: "A",            # KEY_SPACE
    44: "A",            # KEY_Z
    1: "B",             # KEY_ESC
    14: "B",            # KEY_BACKSPACE
    45: "X",            # KEY_X
    35: "X",            # KEY_H
    21: "Y",            # KEY_Y
    19: "Y",            # KEY_R
    25: "START",        # KEY_P
    102: "START",       # KEY_HOME
    15: "RB",           # KEY_TAB
    16: "QUIT",         # KEY_Q
}

AXIS_MAP = {
    ABS_X:    ("LSTICK_X", False),
    ABS_Y:    ("LSTICK_Y", True),
    ABS_RX:   ("RSTICK_X", False),
    ABS_RY:   ("RSTICK_Y", True),
    ABS_Z:    ("L2_AXIS",  False),
    ABS_RZ:   ("R2_AXIS",  False),
    ABS_BRAKE: ("L2_AXIS", False),
    ABS_GAS:   ("R2_AXIS", False),
}

HAT_MAP = {
    ABS_HAT0X: ("DPAD_LEFT", "DPAD_RIGHT"),
    ABS_HAT0Y: ("DPAD_UP",   "DPAD_DOWN"),
}


def normalise_axis(raw: int, minimum: int = -32768, maximum: int = 32767,
                   inverted: bool = False) -> float:
    """Map raw evdev axis value to -1.0..1.0 using the device-reported range.

    Handles both:
      - 16-bit signed: -32768..32767 (modern USB/BT gamepads, default)
      - 8-bit unsigned: 0..255 (legacy devices, triggers on some pads)
    """
    if maximum <= minimum:
        return 0.0
    center = (minimum + maximum) / 2.0
    half_range = (maximum - minimum) / 2.0
    v = (raw - center) / half_range
    v = max(-1.0, min(1.0, v))
    if inverted:
        v = -v
    if abs(v) < 0.08:
        v = 0.0
    return round(v, 3)


# struct input_absinfo: value, minimum, maximum, fuzz, flat, resolution (6 x int32)
_ABSINFO_FMT = "iiiiii"
_ABSINFO_SIZE = struct.calcsize(_ABSINFO_FMT)


def _read_abs_range(fd, axis_code: int):
    """Return (minimum, maximum) for axis_code via EVIOCGABS ioctl, or None."""
    import fcntl
    # EVIOCGABS(axis) = _IOR('E', 0x40 + axis, struct input_absinfo)
    # On Linux x86_64: _IOC_READ=2, 'E'=0x45, size=24 → 0x80184540 + axis
    EVIOCGABS = 0x80184540 + axis_code
    buf = bytearray(_ABSINFO_SIZE)
    try:
        fcntl.ioctl(fd, EVIOCGABS, buf)
        _v, minimum, maximum, _fuzz, _flat, _res = struct.unpack(_ABSINFO_FMT, buf)
        return minimum, maximum
    except Exception:
        return None, None


class ControllerThread(threading.Thread):
    def __init__(self, path: str, controller_id: int,
                 broadcast_fn, disconnect_fn):
        super().__init__(daemon=True)
        self.path = path
        self.controller_id = controller_id
        self.broadcast = broadcast_fn
        self.disconnect_fn = disconnect_fn
        self._stop = threading.Event()
        self._axis_ranges: dict = {}  # axis_code -> (min, max)
        self._button_state: dict = {}
        self._axis_state: dict = {}
        self._hat_state: dict = {}

    def run(self):
        try:
            fd = open(self.path, "rb")
        except (PermissionError, FileNotFoundError) as e:
            log.warning("Cannot open %s: %s", self.path, e)
            return

        name = self._read_name(fd)
        self._cache_axis_ranges(fd)
        log.info("Controller %d connected: %s (%s)",
                 self.controller_id, name, self.path)
        self.broadcast({
            "type": "connect",
            "controller": self.controller_id,
            "name": name,
            "bus": "usb",
            "path": self.path,
        })

        try:
            while not self._stop.is_set():
                r, _, _ = select.select([fd], [], [], 0.1)
                if not r:
                    continue
                data = fd.read(EVSIZE)
                if len(data) < EVSIZE:
                    break
                _, _, ev_type, code, value = struct.unpack(EVFMT, data)
                self._handle_event(ev_type, code, value)
        except OSError:
            pass
        finally:
            fd.close()
            log.info("Controller %d disconnected.", self.controller_id)
            self.broadcast({
                "type": "disconnect",
                "controller": self.controller_id,
            })
            self.disconnect_fn(self.controller_id)

    def _cache_axis_ranges(self, fd) -> None:
        """Pre-read min/max for all mapped axes so normalisation is accurate."""
        for axis_code in list(AXIS_MAP.keys()) + list(HAT_MAP.keys()):
            mn, mx = _read_abs_range(fd, axis_code)
            if mn is not None and mx is not None and mx > mn:
                self._axis_ranges[axis_code] = (mn, mx)
                log.debug("Axis %d range: %d..%d", axis_code, mn, mx)

    def _handle_event(self, ev_type: int, code: int, value: int):
        if ev_type == EV_KEY:
            btn = BUTTON_MAP.get(code)
            if btn:
                pressed = bool(value)
                if self._button_state.get(btn) == pressed:
                    return
                self._button_state[btn] = pressed
                self.broadcast({
                    "type": "button",
                    "button": btn,
                    "state": "pressed" if pressed else "released",
                    "controller": self.controller_id,
                })
        elif ev_type == EV_ABS:
            if code in AXIS_MAP:
                axis_name, inverted = AXIS_MAP[code]
                mn, mx = self._axis_ranges.get(code, (-32768, 32767))
                axis_value = normalise_axis(value, mn, mx, inverted)
                prev = self._axis_state.get(axis_name)
                if prev is not None and abs(axis_value - prev) < AXIS_CHANGE_EPSILON:
                    return
                self._axis_state[axis_name] = axis_value
                self.broadcast({
                    "type": "axis",
                    "axis": axis_name,
                    "value": axis_value,
                    "controller": self.controller_id,
                })
            elif code in HAT_MAP:
                neg_btn, pos_btn = HAT_MAP[code]
                prev = self._hat_state.get(code, 0)
                if prev == value:
                    return
                self._hat_state[code] = value
                if prev < 0:
                    self.broadcast({"type": "button", "button": neg_btn,
                                    "state": "released", "controller": self.controller_id})
                elif prev > 0:
                    self.broadcast({"type": "button", "button": pos_btn,
                                    "state": "released", "controller": self.controller_id})
                if value < 0:
                    self.broadcast({"type": "button", "button": neg_btn,
                                    "state": "pressed", "controller": self.controller_id})
                elif value > 0:
                    self.broadcast({"type": "button", "button": pos_btn,
                                    "state": "pressed", "controller": self.controller_id})

    def _read_name(self, fd) -> str:
        import fcntl
        EVIOCGNAME = 0x80ff4506
        buf = bytearray(256)
        try:
            fcntl.ioctl(fd, EVIOCGNAME, buf)
            return buf.decode(errors="replace").rstrip("\x00").strip()
        except Exception:
            return os.path.basename(self.path)

    def stop(self):
        self._stop.set()


class KeyboardThread(threading.Thread):
    def __init__(self, path: str, broadcast_fn, disconnect_fn):
        super().__init__(daemon=True)
        self.path = path
        self.broadcast = broadcast_fn
        self.disconnect_fn = disconnect_fn
        self._stop = threading.Event()
        self._held_codes: dict = {}

    def run(self):
        try:
            fd = open(self.path, "rb")
        except (PermissionError, FileNotFoundError) as e:
            log.warning("Cannot open keyboard %s: %s", self.path, e)
            return

        name = self._read_name(fd)
        log.info("Keyboard fallback connected: %s (%s)", name, self.path)
        self.broadcast({
            "type": "connect",
            "controller": -1,
            "name": name,
            "bus": "keyboard",
            "path": self.path,
        })

        try:
            while not self._stop.is_set():
                r, _, _ = select.select([fd], [], [], 0.1)
                if not r:
                    self._release_stale_keys()
                    continue
                data = fd.read(EVSIZE)
                if len(data) < EVSIZE:
                    break
                _, _, ev_type, code, value = struct.unpack(EVFMT, data)
                if ev_type != EV_KEY or value not in (0, 1, 2):
                    continue
                button = KEYBOARD_BUTTON_MAP.get(code)
                if not button:
                    continue
                if value == 1:
                    if code in self._held_codes:
                        continue
                    self._held_codes[code] = time.monotonic()
                    state = "pressed"
                elif value == 2:
                    if code in self._held_codes:
                        self._held_codes[code] = time.monotonic()
                    continue
                else:
                    if code not in self._held_codes:
                        continue
                    self._held_codes.pop(code, None)
                    state = "released"
                self.broadcast({
                    "type": "button",
                    "button": button,
                    "state": state,
                    "controller": -1,
                })
        except OSError:
            pass
        finally:
            fd.close()
            self.broadcast({"type": "disconnect", "controller": -1})
            self.disconnect_fn(self.path)

    def _read_name(self, fd) -> str:
        import fcntl
        EVIOCGNAME = 0x80ff4506
        buf = bytearray(256)
        try:
            fcntl.ioctl(fd, EVIOCGNAME, buf)
            return buf.decode(errors="replace").rstrip("\x00").strip()
        except Exception:
            return os.path.basename(self.path)

    def _release_stale_keys(self):
        now = time.monotonic()
        stale = [
            code for code, seen_at in self._held_codes.items()
            if now - seen_at >= KEYBOARD_STALE_RELEASE_SEC
        ]
        for code in stale:
            self._held_codes.pop(code, None)
            button = KEYBOARD_BUTTON_MAP.get(code)
            if button:
                self.broadcast({
                    "type": "button",
                    "button": button,
                    "state": "released",
                    "controller": -1,
                })

    def stop(self):
        self._stop.set()


class InputDaemon:
    def __init__(self, dev_mode: bool = False):
        self.dev_mode = dev_mode
        self._clients: list = []
        self._clients_lock = threading.Lock()
        self._controllers: dict = {}   # id -> ControllerThread
        self._keyboards: dict = {}     # path -> KeyboardThread
        self._keyboard_active = False
        self._next_id = 0
        self._id_lock = threading.Lock()
        self._stop = threading.Event()
        self.keyboard_fallback = cfg_mod.get().get("KEYBOARD_FALLBACK", "yes") == "yes"

    def broadcast(self, event: dict) -> None:
        line = (json.dumps(event) + "\n").encode()
        with self._clients_lock:
            dead = []
            for conn in self._clients:
                try:
                    conn.sendall(line)
                except OSError:
                    dead.append(conn)
            for c in dead:
                self._clients.remove(c)

    def _on_disconnect(self, controller_id: int) -> None:
        with self._id_lock:
            self._controllers.pop(controller_id, None)

    def _on_keyboard_disconnect(self, path: str) -> None:
        self._keyboards.pop(path, None)
        self._keyboard_active = bool(self._keyboards)

    def _next_controller_id(self) -> int:
        with self._id_lock:
            cid = self._next_id
            self._next_id += 1
        return cid

    def _scan_devices(self):
        """Enumerate /dev/input/event* and start a thread per new gamepad."""
        existing_paths = {t.path for t in self._controllers.values()}
        existing_keyboards = set(self._keyboards.keys())
        keyboard_candidates = []
        for path in sorted(glob.glob("/dev/input/event*")):
            if path in existing_paths or path in existing_keyboards:
                continue
            if not self._is_gamepad(path):
                if self.keyboard_fallback and not self._keyboard_active:
                    name = self._keyboard_name(path)
                    if name:
                        keyboard_candidates.append((self._keyboard_score(name), path))
                continue
            cid = self._next_controller_id()
            t = ControllerThread(
                path, cid, self.broadcast, self._on_disconnect)
            self._controllers[cid] = t
            t.start()
        if self.keyboard_fallback and not self._keyboard_active and keyboard_candidates:
            _, path = sorted(keyboard_candidates)[0]
            t = KeyboardThread(path, self.broadcast, self._on_keyboard_disconnect)
            self._keyboards[path] = t
            self._keyboard_active = True
            t.start()

    def _is_gamepad(self, path: str) -> bool:
        """Return True if the device looks like a joystick/gamepad."""
        EV_ABS_bit = 1 << EV_ABS
        EV_KEY_bit = 1 << EV_KEY
        import fcntl
        EVIOCGBIT_EV = 0x80084520
        try:
            with open(path, "rb") as fd:
                buf = bytearray(4)
                fcntl.ioctl(fd, EVIOCGBIT_EV, buf)
                bits = struct.unpack("<I", buf)[0]
                return bool(bits & EV_ABS_bit) and bool(bits & EV_KEY_bit)
        except Exception:
            return False

    def _keyboard_name(self, path: str) -> str:
        """Return the keyboard device name, or an empty string for non-keyboards."""
        import fcntl
        EVIOCGNAME = 0x80ff4506
        try:
            with open(path, "rb") as fd:
                buf = bytearray(256)
                fcntl.ioctl(fd, EVIOCGNAME, buf)
                name = buf.decode(errors="replace").rstrip("\x00").strip().lower()
                if "keyboard" in name or name.endswith("kbd") or "at translated set" in name:
                    return name
        except Exception:
            pass
        return ""

    def _keyboard_score(self, name: str) -> tuple:
        """Prefer external USB/HID keyboards over legacy translated PS/2 mirrors."""
        lowered = name.lower()
        legacy = "at translated set" in lowered
        return (1 if legacy else 0, lowered)

    def run_server(self):
        if os.path.exists(SOCKET_PATH):
            os.remove(SOCKET_PATH)
        os.makedirs(os.path.dirname(SOCKET_PATH), exist_ok=True)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCKET_PATH)
        srv.listen(8)
        srv.setblocking(False)
        log.info("okama-inputd listening on %s", SOCKET_PATH)

        last_scan = 0.0
        while not self._stop.is_set():
            now = time.time()
            if now - last_scan > 2.0:
                self._scan_devices()
                last_scan = now

            r, _, _ = select.select([srv], [], [], 0.5)
            if r:
                try:
                    conn, _ = srv.accept()
                    with self._clients_lock:
                        self._clients.append(conn)
                    log.debug("Client connected (%d total)",
                              len(self._clients))
                except OSError:
                    pass

        srv.close()
        try:
            os.remove(SOCKET_PATH)
        except FileNotFoundError:
            pass

    def test_mode(self):
        """Interactive test — print events to stdout."""
        print("okama-inputd test mode. Press controller buttons. Ctrl-C to exit.")
        self._scan_devices()
        original_broadcast = self.broadcast

        def print_broadcast(event: dict):
            print(json.dumps(event))
            original_broadcast(event)

        self.broadcast = print_broadcast

        try:
            while True:
                self._scan_devices()
                time.sleep(2)
        except KeyboardInterrupt:
            print("\nDone.")


def main():
    p = argparse.ArgumentParser(prog="okama-inputd")
    p.add_argument("--daemon", action="store_true",
                   help="Run as socket server daemon (called by init)")
    p.add_argument("--test", action="store_true",
                   help="Print events to stdout (controller test mode)")
    p.add_argument("--debug", action="store_true")
    args = p.parse_args()

    if args.debug:
        logging.getLogger().setLevel(logging.DEBUG)

    conf = cfg_mod.get()
    dev = conf.is_dev_mode()

    daemon = InputDaemon(dev_mode=dev)

    if args.test:
        daemon.test_mode()
    else:
        daemon.run_server()


if __name__ == "__main__":
    main()
