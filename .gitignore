# OkamaOS .gitignore

# Buildroot clone and build artifacts
buildroot/
output/
build/
# Ignore games directory but allow specific game packages
games/*
!games/voidstriker-pkg/
!games/demo/
!games/pgdrive-pkg/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# Editor
.vscode/
.idea/
*.swp
*~

# Test artifacts
/tmp/

# Secrets — never commit these
/etc/okamaos/parent.conf
board/okamaos/rootfs-overlay/etc/okamaos/parent.conf

# OS
.DS_Store
Thumbs.db

# VirtualBox VM session logs (auto-generated in CWD by VBoxManage / VirtualBox)
*.log
nohup.out
build.log

# Large game packages
*.package
*.love
*.tar.bz2
