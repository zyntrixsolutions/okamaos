#!/usr/bin/env python3
"""okama-update — OTA update manager (MVP: stubbed, design documented).

Usage:
  okama-update check
  okama-update apply <path.okupdate>
  okama-update rollback
"""

import sys
import os

_lib = os.environ.get("OKAMA_LIB", "")
if not _lib:
    _lib = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../lib")
sys.path.insert(0, os.path.abspath(_lib))

import argparse
import okamaos.updates as updates_mod

UPDATE_SERVER = updates_mod.DEFAULT_UPDATE_FEED_URL
UPDATES_DIR = os.environ.get("OKAMA_UPDATES", "/var/okamaos/updates")


def cmd_check(args):
    print("okama-update: checking for updates...")
    print(f"  Update server : {UPDATE_SERVER}")
    notices, error = updates_mod.check_all()

    if error:
        print(f"  Warning       : {error}")

    if not notices:
        print("  Status        : no updates available")
        return

    print(f"  Status        : {len(notices)} update(s) available")
    for notice in notices:
        kind = "OS" if notice["type"] == "os" else "Game"
        print("")
        print(f"{kind}: {notice['title']}")
        print(f"  Installed     : {notice.get('current_version', '?')}")
        print(f"  Available     : {notice.get('version', '?')}")
        if notice.get("summary"):
            print(f"  Summary       : {notice['summary']}")
        if notice.get("download_url"):
            print(f"  Download      : {notice['download_url']}")


def cmd_apply(args):
    path = args.update_file
    if not os.path.exists(path):
        print(f"ERROR: file not found: {path}", file=sys.stderr)
        sys.exit(1)
    print(f"okama-update: applying {path}… (stub)")
    print("  Full OTA apply not implemented in MVP.")
    print("  v1 path: tar-extract signed bundle over inactive partition.")


def cmd_rollback(args):
    print("okama-update: rollback… (stub)")
    print("  v1 path: switch active boot slot to previous, reboot.")


def main():
    p = argparse.ArgumentParser(prog="okama-update",
                                description="OkamaOS OTA update tool")
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("check")

    pa = sub.add_parser("apply")
    pa.add_argument("update_file")

    sub.add_parser("rollback")

    args = p.parse_args()
    {"check": cmd_check, "apply": cmd_apply,
     "rollback": cmd_rollback}[args.command](args)


if __name__ == "__main__":
    main()
